+  async unstable_forkSession(params: ForkSessionRequest): Promise<ForkSessionResponse> {
+    if (!(await harnessIsAuthed(this.harness))) {
+      throw RequestError.authRequired();
+    }
+
+    const aionui = params._meta?.['aionui'];
+    const turnIndex =
+      typeof aionui === 'object' && aionui !== null && 'turnIndex' in aionui
+        ? (aionui as { turnIndex?: unknown }).turnIndex
+        : undefined;
+    if (!Number.isInteger(turnIndex) || (turnIndex as number) < 0) {
+      throw RequestError.invalidParams(
+        { _meta: params._meta },
+        'AionUI session/fork requires a non-negative _meta.aionui.turnIndex',
+      );
+    }
+
+    try {
+      const session = await this.harness.forkSession({
+        id: params.sessionId,
+        turnIndex: turnIndex as number,
+        metadata: { source: 'aionui' },
+      });
+      return { sessionId: session.id };
+    } catch (err) {
+      const code = (err as { code?: string } | undefined)?.code;
+      if (code === 'session.not_found') {
+        throw RequestError.invalidParams(
+          { sessionId: params.sessionId },
+          `Unknown sessionId: ${params.sessionId}`,
+        );
+      }
+      throw err;
+    }
+  }
