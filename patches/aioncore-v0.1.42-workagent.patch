+            UploadError::PayloadTooLarge(message) => ApiError::PayloadTooLarge(message).into_response(),
+            UploadError::NotFound(message) => ApiError::NotFound(message).into_response(),
+            UploadError::ChecksumMismatch(message) => ApiError::UnprocessableEntity(message).into_response(),
