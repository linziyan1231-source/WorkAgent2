+use std::path::PathBuf;
+
+use aionui_common::constants::{RESUMABLE_UPLOAD_CHUNK_SIZE, RESUMABLE_UPLOAD_MAX_SIZE};
+use aionui_file::{UploadError, UploadService};
+use sha2::{Digest, Sha256};
+
+fn upload_service(temp: &tempfile::TempDir) -> UploadService {
+    UploadService::new(temp.path().join("aionui").join("upload-sessions"))
+}
+
+#[tokio::test]
+async fn resumes_from_persisted_payload_length_after_service_restart() {
+    let temp = tempfile::tempdir().unwrap();
+    let first = upload_service(&temp);
+    let session = first
+        .create_session(
+            "report.bin".to_owned(),
+            6,
+            Some("conversation-1".to_owned()),
+            Some("fingerprint-1".to_owned()),
+            Some("request-1".to_owned()),
+        )
+        .await
+        .unwrap();
+    let chunk = b"abc".to_vec();
+    let checksum: [u8; 32] = Sha256::digest(&chunk).into();
+    first
+        .append_chunk(&session.upload_id, 0, chunk, Some(checksum))
+        .await
+        .unwrap();
+
+    let restarted = upload_service(&temp);
+    let resumed = restarted.status(&session.upload_id).await.unwrap();
+
+    assert_eq!(resumed.offset, 3);
+    assert_eq!(resumed.file_size, 6);
+    assert_eq!(resumed.fingerprint.as_deref(), Some("fingerprint-1"));
+}
+
+#[tokio::test]
+async fn reuses_the_session_when_initialization_response_is_retried() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+
+    let first = service
+        .create_session(
+            "report.bin".to_owned(),
+            6,
+            Some("conversation-1".to_owned()),
+            Some("fingerprint-1".to_owned()),
+            Some("request-1".to_owned()),
+        )
+        .await
+        .unwrap();
+    service
+        .append_chunk(&first.upload_id, 0, b"abc".to_vec(), None)
+        .await
+        .unwrap();
+    let retried = service
+        .create_session(
+            "report.bin".to_owned(),
+            6,
+            Some("conversation-1".to_owned()),
+            Some("fingerprint-1".to_owned()),
+            Some("request-1".to_owned()),
+        )
+        .await
+        .unwrap();
+
+    assert_eq!(retried.upload_id, first.upload_id);
+    assert_eq!(retried.offset, 3);
+}
+
+#[tokio::test]
+async fn completes_upload_without_overwriting_an_existing_file() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+    let final_dir = temp.path().join("aionui").join("general");
+    std::fs::create_dir_all(&final_dir).unwrap();
+    std::fs::write(final_dir.join("report.bin"), b"existing").unwrap();
+
+    let session = service
+        .create_session("report.bin".to_owned(), 3, None, None, None)
+        .await
+        .unwrap();
+    let chunk = b"new".to_vec();
+    let checksum: [u8; 32] = Sha256::digest(&chunk).into();
+    service
+        .append_chunk(&session.upload_id, 0, chunk, Some(checksum))
+        .await
+        .unwrap();
+    let completed = PathBuf::from(service.complete(&session.upload_id).await.unwrap());
+    let retried = service.complete(&session.upload_id).await.unwrap();
+
+    assert_eq!(completed.file_name().unwrap(), "report(2).bin");
+    assert_eq!(retried, completed.to_string_lossy());
+    assert_eq!(std::fs::read(final_dir.join("report.bin")).unwrap(), b"existing");
+    assert_eq!(std::fs::read(completed).unwrap(), b"new");
+}
+
+#[tokio::test]
+async fn rejects_offset_and_checksum_mismatches_without_advancing() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+    let session = service
+        .create_session("data.bin".to_owned(), 3, None, None, None)
+        .await
+        .unwrap();
+
+    let error = service
+        .append_chunk(&session.upload_id, 1, b"abc".to_vec(), None)
+        .await
+        .unwrap_err();
+    assert!(matches!(error, UploadError::OffsetMismatch { expected: 0 }));
+
+    let error = service
+        .append_chunk(&session.upload_id, 0, b"abc".to_vec(), Some([0; 32]))
+        .await
+        .unwrap_err();
+    assert!(matches!(error, UploadError::ChecksumMismatch(_)));
+    assert_eq!(service.status(&session.upload_id).await.unwrap().offset, 0);
+}
+
+#[tokio::test]
+async fn enforces_file_and_chunk_size_boundaries_before_writing() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+    let accepted = service
+        .create_session("one-gib.bin".to_owned(), RESUMABLE_UPLOAD_MAX_SIZE, None, None, None)
+        .await
+        .unwrap();
+    service.cancel(&accepted.upload_id).await.unwrap();
+
+    let error = service
+        .create_session(
+            "too-large.bin".to_owned(),
+            RESUMABLE_UPLOAD_MAX_SIZE + 1,
+            None,
+            None,
+            None,
+        )
+        .await
+        .unwrap_err();
+    assert!(matches!(error, UploadError::PayloadTooLarge(_)));
+
+    let small = service
+        .create_session(
+            "chunk.bin".to_owned(),
+            (RESUMABLE_UPLOAD_CHUNK_SIZE + 1) as u64,
+            None,
+            None,
+            None,
+        )
+        .await
+        .unwrap();
+    let error = service
+        .append_chunk(&small.upload_id, 0, vec![0; RESUMABLE_UPLOAD_CHUNK_SIZE + 1], None)
+        .await
+        .unwrap_err();
+    assert!(matches!(error, UploadError::PayloadTooLarge(_)));
+    assert_eq!(service.status(&small.upload_id).await.unwrap().offset, 0);
+}
+
+#[tokio::test]
+async fn upload_sessions_are_not_limited_by_the_chat_mode_pair_cap() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+
+    for index in 0..4 {
+        service
+            .create_session(format!("upload-{index}.bin"), 1, None, None, None)
+            .await
+            .unwrap();
+    }
+}
+
+#[tokio::test]
+async fn reserves_enough_space_for_three_maximum_size_uploads() {
+    let temp = tempfile::tempdir().unwrap();
+    let service = upload_service(&temp);
+
+    for index in 0..3 {
+        service
+            .create_session(
+                format!("maximum-{index}.bin"),
+                RESUMABLE_UPLOAD_MAX_SIZE,
+                None,
+                None,
+                None,
+            )
+            .await
+            .unwrap();
+    }
+
+    let error = service
+        .create_session("over-reservation.bin".to_owned(), 1, None, None, None)
+        .await
+        .unwrap_err();
+    assert!(matches!(error, UploadError::CapacityExceeded(_)));
+}
