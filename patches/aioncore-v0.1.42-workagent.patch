+    /// Fork the provider session after the retained user turn count.
+    ///
+    /// `retained_turn_count` is one-based at this boundary: `1` retains the
+    /// provider's first completed user turn. The zero-history case is handled
+    /// by the conversation service by creating a fresh local conversation.
+    pub async fn fork_session_after_turns(&self, retained_turn_count: usize) -> Result<String, AgentError> {
+        if retained_turn_count == 0 {
+            return Err(AgentError::bad_request(
+                "retained_turn_count must be greater than zero for provider session fork",
+            ));
+        }
+
+        let source_session_id = self.ensure_session_opened().await?;
+        let supports_fork = self
+            .session
+            .read()
+            .await
+            .agent_capabilities()
+            .and_then(|capabilities| capabilities.session_capabilities.fork.as_ref())
+            .is_some();
+        if !supports_fork {
+            return Err(AgentError::bad_request(
+                "The selected agent does not support conversation forking",
+            ));
+        }
+
+        let mut aionui_meta = serde_json::Map::new();
+        aionui_meta.insert(
+            "turnIndex".to_owned(),
+            serde_json::Value::from((retained_turn_count - 1) as u64),
+        );
+        let mut meta = serde_json::Map::new();
+        meta.insert("aionui".to_owned(), serde_json::Value::Object(aionui_meta));
+
+        let mut request =
+            ForkSessionRequest::new(SessionId::new(source_session_id), &self.params.workspace.path).meta(meta);
+        if !self.params.mcp_servers.is_empty() {
+            request = request.mcp_servers(self.params.mcp_servers.clone());
+        }
+        let response = self.protocol.fork_session(request).await?;
+        Ok(response.session_id.to_string())
+    }
+
+    /// Inject additional user guidance into the currently running Codex or Kimi turn.
+    pub async fn steer_active_turn(&self, content: String) -> Result<(), AgentError> {
+        if !matches!(self.backend(), Some("codex" | "kimi")) {
+            return Err(AgentError::bad_request(
+                "Steering is currently available only for Codex and Kimi",
+            ));
+        }
+        let session_id = self
+            .session_id()
+            .await
+            .ok_or_else(|| AgentError::bad_request("There is no active ACP session to steer"))?;
+        let params = serde_json::value::to_raw_value(&serde_json::json!({
+            "sessionId": session_id,
+            "prompt": [{ "type": "text", "text": content }],
+        }))
+        .map_err(|error| AgentError::internal(format!("Failed to encode steer request: {error}")))?;
+        self.protocol
+            .ext_request(ExtRequest::new("_aionui/session/steer", params.into()))
+            .await
+            .map_err(map_steer_protocol_error)?;
+        Ok(())
+    }
