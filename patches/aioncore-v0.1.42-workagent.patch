 /// Grace period before force-killing an ACP process (ms).
 const ACP_KILL_GRACE_MS: u64 = 500;
+/// Delay before the single retry after an ACP initialize timeout.
+const ACP_INIT_RETRY_BACKOFF: Duration = Duration::from_millis(250);
 const OBSERVED_CONFIRMATION_TIMEOUT: Duration = Duration::from_secs(10);
+const STEER_TURN_ENDED_MARKER: &str = "AIONUI_STEER_TURN_ENDED";
+
+async fn retry_init_timeout_once<T, F, Fut>(conversation_id: &str, mut operation: F) -> Result<T, AgentError>
+where
+    F: FnMut() -> Fut,
+    Fut: Future<Output = Result<T, AgentError>>,
+{
+    match operation().await {
+        Err(AgentError::Acp(AcpError::InitTimeout { timeout_secs })) => {
+            warn!(
+                %conversation_id,
+                timeout_secs,
+                backoff_ms = ACP_INIT_RETRY_BACKOFF.as_millis(),
+                "ACP initialize timed out; retrying once with a fresh process"
+            );
+            tokio::time::sleep(ACP_INIT_RETRY_BACKOFF).await;
+            match operation().await {
+                Ok(value) => {
+                    info!(%conversation_id, "ACP initialize retry succeeded");
+                    Ok(value)
+                }
+                Err(err) => {
+                    error!(
+                        %conversation_id,
+                        error = %ErrorChain(&err),
+                        "ACP initialize retry failed"
+                    );
+                    Err(err)
+                }
+            }
+        }
+        result => result,
+    }
+}
+
+fn map_steer_protocol_error(error: AcpError) -> AgentError {
+    match &error {
+        AcpError::InvalidRequest { message } if message.contains(STEER_TURN_ENDED_MARKER) => AgentError::conflict(
+            "The active response ended before steering could be applied; send the guidance again during a running response.",
+        ),
+        _ => AgentError::Acp(error),
+    }
+}
 
