+async fn download_attachments(
+    api: &WeixinApi,
+    msg: &WeixinRawMessage,
+    items: &[WeixinRawItem],
+) -> Vec<UnifiedAttachment> {
+    let mut attachments = Vec::new();
+    for (index, item) in items.iter().enumerate() {
+        let (kind, media_item, default_name) = match item.item_type {
+            Some(ITEM_TYPE_IMAGE) => ("image", item.image_item.as_ref(), format!("image-{}.jpg", index + 1)),
+            Some(ITEM_TYPE_FILE) => ("file", item.file_item.as_ref(), format!("file-{}.bin", index + 1)),
+            _ => continue,
+        };
+        let Some(media_item) = media_item else {
+            warn!(message_id = ?msg.msg_id, media_kind = kind, "WeChat media item has no metadata");
+            continue;
+        };
+        let Some(media) = media_item.media.as_ref() else {
+            warn!(message_id = ?msg.msg_id, media_kind = kind, "WeChat media item has no CDN reference");
+            continue;
+        };
+
+        match api
+            .download_media(media, media_item.aeskey.as_deref(), MAX_INBOUND_MEDIA_BYTES)
+            .await
+        {
+            Ok(bytes) => {
+                let requested_name = media_item.file_name.as_deref().unwrap_or(&default_name);
+                match persist_inbound_media(msg.msg_id.as_deref(), requested_name, &bytes).await {
+                    Ok(path) => {
+                        let file_name = path
+                            .file_name()
+                            .map(|value| value.to_string_lossy().into_owned())
+                            .unwrap_or_else(|| safe_file_name(requested_name));
+                        let mime_type = mime_guess::from_path(&file_name).first_raw().map(str::to_owned);
+                        info!(
+                            message_id = ?msg.msg_id,
+                            media_kind = kind,
+                            media_bytes = bytes.len(),
+                            "WeChat inbound media received"
+                        );
+                        attachments.push(UnifiedAttachment {
+                            file_id: None,
+                            file_name: Some(file_name),
+                            mime_type,
+                            file_size: Some(bytes.len() as u64),
+                            url: Some(path.to_string_lossy().into_owned()),
+                        });
+                    }
+                    Err(error) => warn!(
+                        message_id = ?msg.msg_id,
+                        media_kind = kind,
+                        error = %error,
+                        "Failed to persist WeChat inbound media"
+                    ),
+                }
+            }
+            Err(error) => warn!(
+                message_id = ?msg.msg_id,
+                media_kind = kind,
+                error = %error,
+                "Failed to download/decrypt WeChat inbound media"
+            ),
+        }
+    }
+    attachments
+}
+
+async fn persist_inbound_media(
+    message_id: Option<&str>,
+    requested_name: &str,
+    bytes: &[u8],
+) -> Result<std::path::PathBuf, std::io::Error> {
+    let work_root = std::env::temp_dir().join("aionui-weixin-staging");
+    let message_dir = safe_path_component(message_id.unwrap_or("message"));
+    let target_dir = work_root.join(format!("{message_dir}-{}", uuid::Uuid::new_v4().simple()));
+    tokio::fs::create_dir_all(&target_dir).await?;
+    let path = target_dir.join(safe_file_name(requested_name));
+    tokio::fs::write(&path, bytes).await?;
+    tokio::fs::canonicalize(path).await
+}
+
+fn safe_file_name(value: &str) -> String {
+    let leaf = std::path::Path::new(value)
+        .file_name()
+        .and_then(|name| name.to_str())
+        .unwrap_or("attachment.bin");
+    let sanitized = leaf
+        .chars()
+        .map(|character| {
+            if character.is_control() || matches!(character, '<' | '>' | ':' | '"' | '/' | '\\' | '|' | '?' | '*') {
+                '_'
+            } else {
+                character
+            }
+        })
+        .take(160)
+        .collect::<String>();
+    let sanitized = sanitized.trim_matches([' ', '.']);
+    if sanitized.is_empty() {
+        "attachment.bin".into()
+    } else {
+        sanitized.to_owned()
+    }
+}
+
+fn safe_path_component(value: &str) -> String {
+    let sanitized = value
+        .chars()
+        .filter(|character| character.is_ascii_alphanumeric() || matches!(character, '-' | '_'))
+        .take(48)
+        .collect::<String>();
+    if sanitized.is_empty() {
+        "message".into()
+    } else {
+        sanitized
+    }
+}
