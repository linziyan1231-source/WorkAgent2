+        notifier
+            .handle_completion(&serde_json::json!({
+                "conversation_id": "conv-1",
+                "turn_id": "turn-1"
+            }))
+            .await
+            .unwrap();
+        assert!(sender.sent.lock().unwrap().is_empty());
+    }
+
+    #[tokio::test]
+    async fn conversation_opt_in_still_sends_when_web_conversation_is_bound_to_weixin() {
+        let (notifier, sender, _, channel_repo) = setup(true, true, "aionui").await;
+        channel_repo
+            .update_session_conversation("session-1", "conv-1")
+            .await
+            .unwrap();
+        notifier
+            .handle_completion(&serde_json::json!({
+                "conversation_id": "conv-1",
+                "turn_id": "turn-bound"
+            }))
+            .await
+            .unwrap();
+        assert_eq!(sender.sent.lock().unwrap().len(), 1);
+    }
+
+    #[tokio::test]
+    async fn global_opt_in_still_sends_when_web_conversation_is_bound_to_weixin() {
+        let (notifier, sender, _, channel_repo) = setup(false, true, "aionui").await;
+        channel_repo
+            .update_session_conversation("session-1", "conv-1")
+            .await
+            .unwrap();
+        notifier
+            .handle_completion(&serde_json::json!({
+                "conversation_id": "conv-1",
+                "turn_id": "turn-bound-global"
+            }))
+            .await
+            .unwrap();
+        assert_eq!(sender.sent.lock().unwrap().len(), 1);
+    }
+
+    #[tokio::test]
+    async fn completion_sends_local_result_as_direct_file() {
+        let (notifier, sender, conversation_repo, _) = setup(true, false, "aionui").await;
+        let file = std::env::temp_dir().join(format!("weixin-result-{}.txt", uuid::Uuid::new_v4()));
+        tokio::fs::write(&file, b"result").await.unwrap();
+        conversation_repo
+            .insert_message(&MessageRow {
+                id: "message-file".into(),
+                conversation_id: "conv-1".into(),
+                msg_id: None,
+                r#type: "text".into(),
+                content: serde_json::json!({
+                    "content": format!("结果文件：[result.txt]({})", file.to_string_lossy())
+                })
+                .to_string(),
+                position: Some("left".into()),
+                status: Some("finish".into()),
+                hidden: false,
+                created_at: now_ms() + 1,
+            })
+            .await
+            .unwrap();
+        notifier
+            .handle_completion(&serde_json::json!({ "conversation_id": "conv-1", "turn_id": "turn-file" }))
+            .await
+            .unwrap();
+        let canonical_file = tokio::fs::canonicalize(&file).await.unwrap();
+        {
+            let sent = sender.sent.lock().unwrap();
+            assert_eq!(sent.len(), 2);
+            assert_eq!(
+                sent[0].2.text.as_deref(),
+                Some("任务完成：季度报告\n\n结果文件：result.txt")
+            );
+            assert_eq!(sent[1].2.message_type, OutgoingMessageType::File);
+            assert_eq!(
+                sent[1].2.file_url.as_deref(),
+                Some(canonical_file.to_string_lossy().as_ref())
+            );
+        }
+        let _ = tokio::fs::remove_file(file).await;
+    }
