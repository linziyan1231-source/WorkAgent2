+    use aionui_db::{
+        IChannelRepository, IClientPreferenceRepository, IConversationRepository, IUserRepository,
+        SqliteChannelRepository, SqliteClientPreferenceRepository, SqliteConversationRepository, SqliteUserRepository,
+        init_database_memory,
+    };
+
+    use super::*;
+    use crate::error::ChannelError;
+
+    #[derive(Default)]
+    struct CapturingSender {
+        sent: StdMutex<Vec<(String, String, UnifiedOutgoingMessage)>>,
+    }
+
+    #[async_trait::async_trait]
+    impl ChannelSender for CapturingSender {
+        async fn send_message(
+            &self,
+            plugin_id: &str,
+            chat_id: &str,
+            message: UnifiedOutgoingMessage,
+        ) -> Result<String, ChannelError> {
+            self.sent
+                .lock()
+                .unwrap()
+                .push((plugin_id.to_owned(), chat_id.to_owned(), message));
+            Ok("sent".into())
+        }
+
+        async fn edit_message(
+            &self,
+            _plugin_id: &str,
+            _chat_id: &str,
+            _message_id: &str,
+            _message: UnifiedOutgoingMessage,
+        ) -> Result<(), ChannelError> {
+            Ok(())
+        }
+    }
+
+    async fn setup(
+        conversation_enabled: bool,
+        global_enabled: bool,
+        source: &str,
+    ) -> (
+        WeixinCompletionNotifier,
+        Arc<CapturingSender>,
+        Arc<SqliteConversationRepository>,
+        Arc<SqliteChannelRepository>,
+    ) {
+        let db = init_database_memory().await.unwrap();
+        let user_repo = SqliteUserRepository::new(db.pool().clone());
+        let owner = user_repo.create_user("owner", "test-password-hash").await.unwrap();
+        let conversation_repo = Arc::new(SqliteConversationRepository::new(db.pool().clone()));
+        let channel_repo = Arc::new(SqliteChannelRepository::new(db.pool().clone()));
+        let pref_repo = Arc::new(SqliteClientPreferenceRepository::new(db.pool().clone()));
+        let sender = Arc::new(CapturingSender::default());
+        let now = now_ms();
+
+        conversation_repo
+            .create(&ConversationRow {
+                id: "conv-1".into(),
+                user_id: owner.id,
+                name: "季度报告".into(),
+                r#type: "acp".into(),
+                extra: serde_json::json!({ "weixinReminderEnabled": conversation_enabled }).to_string(),
+                model: None,
+                status: Some("finished".into()),
+                source: Some(source.into()),
+                channel_chat_id: None,
+                pinned: false,
+                pinned_at: None,
+                created_at: now,
+                updated_at: now,
+            })
+            .await
+            .unwrap();
+        conversation_repo
+            .insert_message(&MessageRow {
+                id: "message-1".into(),
+                conversation_id: "conv-1".into(),
+                msg_id: None,
+                r#type: "text".into(),
+                content: serde_json::json!({ "content": "报告已经生成。" }).to_string(),
+                position: Some("left".into()),
+                status: Some("finish".into()),
+                hidden: false,
+                created_at: now,
+            })
+            .await
+            .unwrap();
+        channel_repo
+            .create_user(&AssistantUserRow {
+                id: "wx-user".into(),
+                platform_user_id: "wx-target".into(),
+                platform_type: "weixin".into(),
+                display_name: None,
+                authorized_at: now,
+                last_active: Some(now),
+                session_id: Some("context-token".into()),
+            })
+            .await
+            .unwrap();
+        channel_repo
+            .get_or_create_session(
+                "wx-user",
+                "wx-target",
+                &AssistantSessionRow {
+                    id: "session-1".into(),
+                    user_id: "wx-user".into(),
+                    agent_type: "acp".into(),
+                    conversation_id: None,
+                    workspace: None,
+                    chat_id: Some("wx-target".into()),
+                    created_at: now,
+                    last_activity: now,
+                },
+            )
+            .await
+            .unwrap();
+        if global_enabled {
+            pref_repo.upsert_batch(&[(GLOBAL_DELIVERY_KEY, "true")]).await.unwrap();
+        }
+
+        (
+            WeixinCompletionNotifier::new(
+                conversation_repo.clone(),
+                channel_repo.clone(),
+                pref_repo,
+                sender.clone(),
+                std::env::temp_dir(),
+            ),
+            sender,
+            conversation_repo,
+            channel_repo,
+        )
+    }
+
+    #[tokio::test]
+    async fn conversation_opt_in_sends_final_answer_to_weixin() {
+        let (notifier, sender, _, channel_repo) = setup(true, false, "aionui").await;
+        notifier
+            .handle_completion(&serde_json::json!({
+                "conversation_id": "conv-1",
+                "turn_id": "turn-1"
+            }))
+            .await
+            .unwrap();
+
+        let sent = sender.sent.lock().unwrap();
+        assert_eq!(sent.len(), 1);
+        assert_eq!(sent[0].0, "weixin");
+        assert_eq!(sent[0].1, "wx-target");
+        assert_eq!(sent[0].2.text.as_deref(), Some("任务完成：季度报告\n\n报告已经生成。"));
+        assert_eq!(sent[0].2.reply_to_message_id.as_deref(), Some("context-token"));
+        drop(sent);
+        let session = channel_repo.get_session("session-1").await.unwrap().unwrap();
+        assert_eq!(session.conversation_id.as_deref(), Some("conv-1"));
+    }
+
+    #[tokio::test]
+    async fn global_opt_in_sends_when_conversation_is_disabled() {
+        let (notifier, sender, _, _) = setup(false, true, "aionui").await;
