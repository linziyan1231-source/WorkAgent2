+fn validate_ilink_business_response(endpoint: &str, response: &serde_json::Value) -> Result<(), ChannelError> {
+    let failed_code = ["ret", "errcode", "code"].into_iter().find_map(|field| {
+        let value = response.get(field)?;
+        let code = value
+            .as_i64()
+            .or_else(|| value.as_str().and_then(|text| text.parse::<i64>().ok()))?;
+        (code != 0).then_some((field, code))
+    });
+    if let Some((field, code)) = failed_code {
+        let detail = response
+            .get("errmsg")
+            .or_else(|| response.get("msg"))
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or("unknown provider error")
+            .chars()
+            .take(160)
+            .collect::<String>();
+        return Err(ChannelError::MessageSendFailed(format!(
+            "{endpoint} rejected by WeChat ({field}={code}): {detail}"
+        )));
+    }
+    Ok(())
+}
+
+fn encrypt_aes_128_ecb_pkcs7(plaintext: &[u8], key: &[u8; 16]) -> Result<Vec<u8>, ChannelError> {
+    let padding = 16 - (plaintext.len() % 16);
+    let mut ciphertext = Vec::with_capacity(plaintext.len() + padding);
+    ciphertext.extend_from_slice(plaintext);
+    ciphertext.resize(plaintext.len() + padding, padding as u8);
+    let cipher = Aes128::new_from_slice(key)
+        .map_err(|error| ChannelError::PlatformApi(format!("invalid media AES key: {error}")))?;
+    for block in ciphertext.chunks_exact_mut(16) {
+        cipher.encrypt_block(block.into());
+    }
+    Ok(ciphertext)
+}
+
+fn media_download_url(media: &MediaEncryptInfo, cdn_base_url: &str) -> Result<String, ChannelError> {
+    if let Some(full_url) = media.full_url.as_deref().filter(|value| !value.trim().is_empty()) {
+        let parsed = reqwest::Url::parse(full_url)
+            .map_err(|e| ChannelError::PlatformApi(format!("invalid media full_url: {e}")))?;
+        let trusted_host = parsed
+            .host_str()
+            .is_some_and(|host| host == "weixin.qq.com" || host.ends_with(".weixin.qq.com"));
+        if parsed.scheme() == "https" && trusted_host {
+            return Ok(parsed.into());
+        }
+        return Err(ChannelError::PlatformApi("untrusted media full_url".into()));
+    }
+
+    let query = media
+        .encrypt_query_param
+        .as_deref()
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| ChannelError::PlatformApi("media has no download parameter".into()))?;
+    let mut url = reqwest::Url::parse(&format!("{}/download", cdn_base_url.trim_end_matches('/')))
+        .map_err(|e| ChannelError::PlatformApi(format!("invalid CDN URL: {e}")))?;
+    url.query_pairs_mut().append_pair("encrypted_query_param", query);
+    Ok(url.into())
+}
+
+fn parse_media_key(encoded_key: Option<&str>, raw_hex_key: Option<&str>) -> Result<[u8; 16], ChannelError> {
+    if let Some(raw_hex) = raw_hex_key.filter(|value| !value.is_empty()) {
+        return decode_hex_key(raw_hex);
+    }
+
+    let encoded = encoded_key
+        .filter(|value| !value.is_empty())
+        .ok_or_else(|| ChannelError::PlatformApi("media has no AES key".into()))?;
+    let decoded = base64::engine::general_purpose::STANDARD
+        .decode(encoded)
+        .map_err(|e| ChannelError::PlatformApi(format!("invalid media AES key: {e}")))?;
+    match decoded.len() {
+        16 => decoded
+            .try_into()
+            .map_err(|_| ChannelError::PlatformApi("invalid media AES key length".into())),
+        32 if decoded.iter().all(u8::is_ascii_hexdigit) => {
+            let hex = std::str::from_utf8(&decoded)
+                .map_err(|e| ChannelError::PlatformApi(format!("invalid media AES hex key: {e}")))?;
+            decode_hex_key(hex)
+        }
+        size => Err(ChannelError::PlatformApi(format!(
+            "media AES key must decode to 16 raw bytes or 32 hex characters, got {size} bytes"
+        ))),
+    }
+}
+
+fn decode_hex_key(value: &str) -> Result<[u8; 16], ChannelError> {
+    if value.len() != 32 || !value.as_bytes().iter().all(u8::is_ascii_hexdigit) {
+        return Err(ChannelError::PlatformApi(
+            "media AES hex key must contain 32 hexadecimal characters".into(),
+        ));
+    }
+    let mut key = [0u8; 16];
+    for (index, byte) in key.iter_mut().enumerate() {
+        *byte = u8::from_str_radix(&value[index * 2..index * 2 + 2], 16)
+            .map_err(|e| ChannelError::PlatformApi(format!("invalid media AES hex key: {e}")))?;
+    }
+    Ok(key)
+}
+
+fn decrypt_aes_128_ecb_pkcs7(mut ciphertext: Vec<u8>, key: &[u8; 16]) -> Result<Vec<u8>, ChannelError> {
+    if ciphertext.is_empty() || !ciphertext.len().is_multiple_of(16) {
+        return Err(ChannelError::PlatformApi(
+            "encrypted media length is not a positive multiple of 16".into(),
+        ));
+    }
+    let cipher =
+        Aes128::new_from_slice(key).map_err(|e| ChannelError::PlatformApi(format!("invalid media AES key: {e}")))?;
+    for block in ciphertext.chunks_exact_mut(16) {
+        cipher.decrypt_block(block.into());
+    }
+    let padding = *ciphertext
+        .last()
+        .ok_or_else(|| ChannelError::PlatformApi("decrypted media is empty".into()))? as usize;
+    if !(1..=16).contains(&padding)
+        || !ciphertext[ciphertext.len() - padding..]
+            .iter()
+            .all(|value| *value as usize == padding)
+    {
+        return Err(ChannelError::PlatformApi("invalid media PKCS#7 padding".into()));
+    }
+    ciphertext.truncate(ciphertext.len() - padding);
+    Ok(ciphertext)
+}
