diff --git a/crates/aionui-channel/src/completion_notifier.rs b/crates/aionui-channel/src/completion_notifier.rs
new file mode 100644
index 0000000000000000000000000000000000000000..32630dbb17f99ee51d9a7829ef0a599951b4c706
--- /dev/null
+++ b/crates/aionui-channel/src/completion_notifier.rs
@@ -0,0 +1,634 @@
+use std::collections::{HashSet, VecDeque};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+use aionui_api_types::WebSocketMessage;
+use aionui_db::models::AssistantSessionRow;
+use aionui_db::{
+    IChannelRepository, IClientPreferenceRepository, IConversationRepository, MessagePageDirection, MessagePageParams,
+};
+use tokio::sync::{Mutex, broadcast};
+use tracing::{info, warn};
+
+use crate::stream_relay::ChannelSender;
+use crate::types::{OutgoingMessageType, UnifiedOutgoingMessage};
+
+const GLOBAL_DELIVERY_KEY: &str = "system.weixinCompletionDeliveryEnabled";
+const RECENT_TURN_LIMIT: usize = 1024;
+const MAX_NOTIFICATION_CHARS: usize = 6000;
+
+/// Sends completion summaries for Web conversations to the most recently
+/// active authorized WeChat chat when global or conversation-level delivery is
+/// enabled. WeChat-originated conversations are excluded because their live
+/// channel relay already sends the final response. A Web conversation remains
+/// eligible even when a WeChat session is bound to it: binding is navigation
+/// state, not a notification override.
+pub struct WeixinCompletionNotifier {
+    conversation_repo: Arc<dyn IConversationRepository>,
+    channel_repo: Arc<dyn IChannelRepository>,
+    client_pref_repo: Arc<dyn IClientPreferenceRepository>,
+    sender: Arc<dyn ChannelSender>,
+    recent_turns: Mutex<(HashSet<String>, VecDeque<String>)>,
+    work_dir: PathBuf,
+}
+
+impl WeixinCompletionNotifier {
+    pub fn new(
+        conversation_repo: Arc<dyn IConversationRepository>,
+        channel_repo: Arc<dyn IChannelRepository>,
+        client_pref_repo: Arc<dyn IClientPreferenceRepository>,
+        sender: Arc<dyn ChannelSender>,
+        work_dir: PathBuf,
+    ) -> Self {
+        Self {
+            conversation_repo,
+            channel_repo,
+            client_pref_repo,
+            sender,
+            recent_turns: Mutex::new((HashSet::new(), VecDeque::new())),
+            work_dir,
+        }
+    }
+
+    pub async fn run(self: Arc<Self>, mut rx: broadcast::Receiver<WebSocketMessage<serde_json::Value>>) {
+        loop {
+            match rx.recv().await {
+                Ok(event) if event.name == "turn.completed" => {
+                    if let Err(error) = self.handle_completion(&event.data).await {
+                        warn!(error = %error, "WeChat completion notification failed");
+                    }
+                }
+                Ok(_) => {}
+                Err(broadcast::error::RecvError::Lagged(count)) => {
+                    warn!(count, "WeChat completion notifier lagged behind event bus");
+                }
+                Err(broadcast::error::RecvError::Closed) => return,
+            }
+        }
+    }
+
+    async fn handle_completion(&self, data: &serde_json::Value) -> Result<(), String> {
+        let conversation_id = data
+            .get("conversation_id")
+            .and_then(serde_json::Value::as_str)
+            .filter(|value| !value.is_empty())
+            .ok_or_else(|| "turn.completed event has no conversation_id".to_owned())?;
+        let turn_id = data
+            .get("turn_id")
+            .and_then(serde_json::Value::as_str)
+            .filter(|value| !value.is_empty())
+            .unwrap_or(conversation_id);
+        if !self.mark_turn_once(turn_id).await {
+            return Ok(());
+        }
+
+        let Some(conversation) = self
+            .conversation_repo
+            .get(conversation_id)
+            .await
+            .map_err(|error| format!("read conversation: {error}"))?
+        else {
+            return Ok(());
+        };
+        if conversation.source.as_deref() == Some("weixin") {
+            return Ok(());
+        }
+
+        let conversation_enabled = serde_json::from_str::<serde_json::Value>(&conversation.extra)
+            .ok()
+            .and_then(|extra| extra.get("weixinReminderEnabled").and_then(serde_json::Value::as_bool))
+            .unwrap_or(false);
+        if !conversation_enabled && !self.global_delivery_enabled().await? {
+            return Ok(());
+        }
+
+        let Some((session, context_token)) = self.latest_weixin_session().await? else {
+            warn!(
+                conversation_id,
+                "WeChat completion notification skipped because no authorized chat exists"
+            );
+            return Ok(());
+        };
+        let Some(chat_id) = session.chat_id.as_deref() else {
+            return Ok(());
+        };
+        let (summary, files) = self.completion_payload(conversation_id, &conversation.name).await?;
+        self.sender
+            .send_message(
+                "weixin",
+                chat_id,
+                UnifiedOutgoingMessage {
+                    message_type: OutgoingMessageType::Text,
+                    text: Some(summary),
+                    parse_mode: None,
+                    buttons: None,
+                    keyboard: None,
+                    image_url: None,
+                    file_url: None,
+                    file_name: None,
+                    media_actions: None,
+                    // WeChat uses its reply context token for out-of-band
+                    // messages. Other channel plugins retain the ordinary
+                    // reply-to interpretation of this field.
+                    reply_to_message_id: context_token.clone(),
+                    silent: None,
+                },
+            )
+            .await
+            .map_err(|error| format!("send WeChat notification: {error}"))?;
+        self.channel_repo
+            .update_session_conversation(&session.id, conversation_id)
+            .await
+            .map_err(|error| format!("bind WeChat notification session: {error}"))?;
+        for file in files {
+            let file_name = file.file_name().map(|value| value.to_string_lossy().into_owned());
+            self.sender
+                .send_message(
+                    "weixin",
+                    chat_id,
+                    UnifiedOutgoingMessage {
+                        message_type: OutgoingMessageType::File,
+                        text: None,
+                        parse_mode: None,
+                        buttons: None,
+                        keyboard: None,
+                        image_url: None,
+                        file_url: Some(file.to_string_lossy().into_owned()),
+                        file_name,
+                        media_actions: None,
+                        reply_to_message_id: context_token.clone(),
+                        silent: None,
+                    },
+                )
+                .await
+                .map_err(|error| format!("send WeChat result file: {error}"))?;
+        }
+
+        info!(conversation_id, session_id = %session.id, chat_id, "WeChat completion notification sent");
+        Ok(())
+    }
+
+    async fn mark_turn_once(&self, turn_id: &str) -> bool {
+        let mut recent = self.recent_turns.lock().await;
+        if recent.0.contains(turn_id) {
+            return false;
+        }
+        recent.0.insert(turn_id.to_owned());
+        recent.1.push_back(turn_id.to_owned());
+        if recent.1.len() > RECENT_TURN_LIMIT
+            && let Some(expired) = recent.1.pop_front()
+        {
+            recent.0.remove(&expired);
+        }
+        true
+    }
+
+    async fn global_delivery_enabled(&self) -> Result<bool, String> {
+        let prefs = self
+            .client_pref_repo
+            .get_by_keys(&[GLOBAL_DELIVERY_KEY])
+            .await
+            .map_err(|error| format!("read client preference: {error}"))?;
+        Ok(prefs
+            .first()
+            .and_then(|pref| serde_json::from_str::<bool>(&pref.value).ok())
+            .unwrap_or(false))
+    }
+
+    async fn latest_weixin_session(&self) -> Result<Option<(AssistantSessionRow, Option<String>)>, String> {
+        let users = self
+            .channel_repo
+            .get_all_users()
+            .await
+            .map_err(|error| format!("list channel users: {error}"))?;
+        let weixin_users = users
+            .into_iter()
+            .filter(|user| user.platform_type == "weixin")
+            .map(|user| (user.id, user.session_id))
+            .collect::<std::collections::HashMap<_, _>>();
+        if weixin_users.is_empty() {
+            return Ok(None);
+        }
+
+        let sessions = self
+            .channel_repo
+            .get_all_sessions()
+            .await
+            .map_err(|error| format!("list channel sessions: {error}"))?;
+        Ok(sessions
+            .into_iter()
+            .filter(|session| session.chat_id.is_some() && weixin_users.contains_key(&session.user_id))
+            .max_by_key(|session| session.last_activity)
+            .map(|session| {
+                let context = weixin_users.get(&session.user_id).cloned().flatten();
+                (session, context)
+            }))
+    }
+
+    async fn completion_payload(
+        &self,
+        conversation_id: &str,
+        conversation_name: &str,
+    ) -> Result<(String, Vec<PathBuf>), String> {
+        let messages = self
+            .conversation_repo
+            .list_messages_page(
+                conversation_id,
+                &MessagePageParams {
+                    limit: 100,
+                    direction: MessagePageDirection::InitialLatest,
+                },
+            )
+            .await
+            .map_err(|error| format!("list conversation messages: {error}"))?;
+        let turn_messages = messages
+            .items
+            .iter()
+            .rev()
+            .take_while(|message| message.position.as_deref() != Some("right"))
+            .filter(|message| !message.hidden && message.position.as_deref() == Some("left"))
+            .collect::<Vec<_>>();
+        let final_text = turn_messages
+            .iter()
+            .find_map(|message| message_result_text(&message.content, message.r#type == "text"))
+            .unwrap_or_else(|| "任务已经完成。".to_owned());
+        let files = self.local_result_files(&turn_messages).await;
+        let visible_text = strip_local_file_links(&final_text);
+        Ok((
+            truncate_chars(
+                &format!("任务完成：{conversation_name}\n\n{visible_text}"),
+                MAX_NOTIFICATION_CHARS,
+            ),
+            files,
+        ))
+    }
+
+    async fn local_result_files(&self, messages: &[&aionui_db::models::MessageRow]) -> Vec<PathBuf> {
+        let Ok(root) = tokio::fs::canonicalize(&self.work_dir).await else {
+            return Vec::new();
+        };
+        let mut seen = HashSet::new();
+        let mut files = Vec::new();
+        for message in messages {
+            for candidate in local_file_link_targets(&message.content) {
+                let path = normalize_local_link(&candidate);
+                let Ok(canonical) = tokio::fs::canonicalize(&path).await else {
+                    continue;
+                };
+                let Ok(metadata) = tokio::fs::symlink_metadata(&canonical).await else {
+                    continue;
+                };
+                if canonical.starts_with(&root)
+                    && metadata.is_file()
+                    && !metadata.file_type().is_symlink()
+                    && seen.insert(canonical.clone())
+                {
+                    files.push(canonical);
+                }
+            }
+        }
+        files
+    }
+}
+
+fn message_result_text(content: &str, prefer_text: bool) -> Option<String> {
+    let value = serde_json::from_str::<serde_json::Value>(content).ok()?;
+    for key in ["content", "message", "output", "result", "text"] {
+        if let Some(text) = value
+            .get(key)
+            .and_then(serde_json::Value::as_str)
+            .filter(|text| !text.trim().is_empty())
+        {
+            return Some(text.to_owned());
+        }
+    }
+    if let Some(text) = value.as_str().filter(|text| !text.trim().is_empty()) {
+        return Some(text.to_owned());
+    }
+    (!prefer_text && value != serde_json::Value::Null)
+        .then(|| serde_json::to_string_pretty(&value).unwrap_or_else(|_| content.to_owned()))
+}
+
+fn local_file_link_targets(text: &str) -> Vec<String> {
+    let Ok(regex) = regex::Regex::new(r#"\[[^\]]*\]\((?:file://)?([^\)]+)\)"#) else {
+        return Vec::new();
+    };
+    regex
+        .captures_iter(text)
+        .filter_map(|capture| {
+            capture
+                .get(1)
+                .map(|value| value.as_str().trim_matches(['<', '>']).to_owned())
+        })
+        .collect()
+}
+
+fn strip_local_file_links(text: &str) -> String {
+    regex::Regex::new(r#"\[([^\]]+)\]\((?:file://)?[^\)]+\)"#)
+        .map(|regex| regex.replace_all(text, "$1").into_owned())
+        .unwrap_or_else(|_| text.to_owned())
+}
+
+fn normalize_local_link(value: &str) -> PathBuf {
+    let value = value.strip_prefix("sandbox:").unwrap_or(value);
+    Path::new(value).to_path_buf()
+}
+
+fn truncate_chars(value: &str, max_chars: usize) -> String {
+    if value.chars().count() <= max_chars {
+        return value.to_owned();
+    }
+    let mut truncated = value.chars().take(max_chars.saturating_sub(1)).collect::<String>();
+    truncated.push('…');
+    truncated
+}
+
