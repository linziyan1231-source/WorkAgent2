+        }
+        let Ok(metadata) = read_upload_metadata(&entry.path()) else {
+            continue;
+        };
+        if metadata.client_request_id.as_deref() != Some(client_request_id) {
+            continue;
+        }
+        if entry.path().join(UPLOAD_SESSION_COMPLETION_FILE).is_file() {
+            continue;
+        }
+        if metadata.file_name != file_name
+            || metadata.file_size != file_size
+            || metadata.conversation_id.as_deref() != conversation_id
+            || metadata.fingerprint.as_deref() != fingerprint
+        {
+            return Err(UploadError::BadRequest(
+                "client request id is already bound to a different upload".to_owned(),
+            ));
+        }
+        let offset = std::fs::symlink_metadata(entry.path().join(UPLOAD_SESSION_PAYLOAD_FILE))
+            .map_err(|error| UploadError::Internal(format!("cannot inspect upload payload: {error}")))?
+            .len();
+        return Ok(Some((metadata, offset)));
+    }
+    Ok(None)
+}
+
+fn cleanup_expired_sessions(root: &Path) -> Result<(), UploadError> {
+    let now = now_unix_ms();
+    let mut removed = 0usize;
+    for entry in std::fs::read_dir(root)
+        .map_err(|error| UploadError::Internal(format!("cannot inspect upload sessions: {error}")))?
+    {
+        let entry =
+            entry.map_err(|error| UploadError::Internal(format!("cannot inspect upload session entry: {error}")))?;
+        if !entry
+            .file_type()
+            .map_err(|error| UploadError::Internal(format!("cannot inspect upload session type: {error}")))?
+            .is_dir()
+        {
+            continue;
+        }
+        if read_upload_metadata(&entry.path()).is_ok_and(|metadata| metadata.expires_at_unix_ms <= now) {
+            std::fs::remove_dir_all(entry.path())
+                .map_err(|error| UploadError::Internal(format!("cannot remove expired upload session: {error}")))?;
+            removed += 1;
+        }
+    }
+    if removed > 0 {
+        info!(removed, "expired resumable upload sessions removed");
+    }
+    Ok(())
+}
+
+fn load_session(root: &Path, upload_id: &str) -> Result<UploadSession, UploadError> {
+    if read_completed_upload(root, upload_id)?.is_some() {
+        let session_dir = session_directory(root, upload_id)?;
+        let metadata = read_upload_metadata(&session_dir)?;
+        return Ok(metadata_to_session(metadata.clone(), metadata.file_size));
+    }
+    let (metadata, _, offset) = load_session_parts(root, upload_id)?;
+    Ok(metadata_to_session(metadata, offset))
+}
+
+fn read_completed_upload(root: &Path, upload_id: &str) -> Result<Option<String>, UploadError> {
+    let session_dir = session_directory(root, upload_id)?;
+    if !session_dir.is_dir() {
+        return Err(UploadError::NotFound("upload session not found".to_owned()));
+    }
+    let completion_path = session_dir.join(UPLOAD_SESSION_COMPLETION_FILE);
+    if !completion_path.is_file() {
+        return Ok(None);
+    }
+    let encoded = std::fs::read(&completion_path)
+        .map_err(|error| UploadError::Internal(format!("cannot read upload completion: {error}")))?;
+    let completed: String = serde_json::from_slice(&encoded)
+        .map_err(|error| UploadError::Internal(format!("cannot decode upload completion: {error}")))?;
+    if !Path::new(&completed).is_file() {
+        std::fs::remove_file(completion_path)
+            .map_err(|error| UploadError::Internal(format!("cannot repair upload completion: {error}")))?;
+        return Ok(None);
+    }
+    Ok(Some(completed))
+}
+
+fn load_session_parts(root: &Path, upload_id: &str) -> Result<(UploadSessionMetadata, PathBuf, u64), UploadError> {
+    let session_dir = session_directory(root, upload_id)?;
+    if !session_dir.is_dir() {
+        return Err(UploadError::NotFound("upload session not found".to_owned()));
+    }
+    let metadata = read_upload_metadata(&session_dir)?;
+    if metadata.upload_id != upload_id {
+        return Err(UploadError::Internal("upload session identity mismatch".to_owned()));
+    }
+    if metadata.expires_at_unix_ms <= now_unix_ms() {
+        let _ = std::fs::remove_dir_all(&session_dir);
+        return Err(UploadError::NotFound("upload session expired".to_owned()));
+    }
+    let payload_path = session_dir.join(UPLOAD_SESSION_PAYLOAD_FILE);
+    let offset = std::fs::symlink_metadata(&payload_path)
+        .map_err(|error| UploadError::Internal(format!("cannot inspect upload payload: {error}")))?
+        .len();
+    if offset > metadata.file_size {
+        return Err(UploadError::Internal(
+            "upload payload is larger than the declared file size".to_owned(),
+        ));
+    }
+    Ok((metadata, payload_path, offset))
+}
+
+fn read_upload_metadata(session_dir: &Path) -> Result<UploadSessionMetadata, UploadError> {
+    let encoded = std::fs::read(session_dir.join(UPLOAD_SESSION_METADATA_FILE))
+        .map_err(|error| UploadError::Internal(format!("cannot read upload session: {error}")))?;
+    serde_json::from_slice(&encoded)
+        .map_err(|error| UploadError::Internal(format!("cannot decode upload session: {error}")))
+}
+
+fn session_directory(root: &Path, upload_id: &str) -> Result<PathBuf, UploadError> {
+    Ok(root.join(normalize_upload_id(upload_id)?))
+}
+
+fn normalize_upload_id(upload_id: &str) -> Result<String, UploadError> {
+    Uuid::parse_str(upload_id.trim())
+        .map(|value| value.to_string())
+        .map_err(|_| UploadError::BadRequest("invalid upload id".to_owned()))
+}
+
+fn normalize_optional_component(label: &str, value: Option<String>) -> Result<Option<String>, UploadError> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Ok(None);
+    }
+    validate_upload_component(label, trimmed)?;
+    Ok(Some(trimmed.to_owned()))
+}
+
+fn normalize_client_request_id(value: Option<String>) -> Result<Option<String>, UploadError> {
+    let Some(value) = value else {
+        return Ok(None);
+    };
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Ok(None);
+    }
+    if trimmed.len() > 128
+        || !trimmed
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'/' | b'=' | b'-' | b'_'))
+    {
+        return Err(UploadError::BadRequest("client request id is invalid".to_owned()));
+    }
+    Ok(Some(trimmed.to_owned()))
+}
+
+fn validate_upload_component(label: &str, value: &str) -> Result<(), UploadError> {
+    if value.trim().is_empty() {
+        return Err(UploadError::BadRequest(format!("{label} must not be empty")));
+    }
+    if has_traversal(value) || value.contains('/') || value.contains('\\') {
+        return Err(UploadError::BadRequest(format!("{label} contains invalid characters")));
+    }
+    Ok(())
+}
+
+fn upload_final_directory(root: &Path, conversation_id: Option<&str>) -> Result<PathBuf, UploadError> {
+    let aionui_root = root
+        .parent()
+        .ok_or_else(|| UploadError::Internal("upload session root has no parent".to_owned()))?;
+    Ok(aionui_root.join(conversation_id.unwrap_or("general")))
+}
+
+fn metadata_to_session(metadata: UploadSessionMetadata, offset: u64) -> UploadSession {
+    UploadSession {
+        upload_id: metadata.upload_id,
+        offset,
+        file_size: metadata.file_size,
+        fingerprint: metadata.fingerprint,
+        expires_at_unix_ms: metadata.expires_at_unix_ms,
+    }
+}
+
+fn now_unix_ms() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+        .try_into()
+        .unwrap_or(u64::MAX)
+}
+
+fn upload_join_error(error: tokio::task::JoinError) -> UploadError {
+    UploadError::Internal(format!("upload filesystem task failed: {error}"))
+}
