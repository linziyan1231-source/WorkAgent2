+async fn archive_weixin_files(
+    work_dir: &Path,
+    session: &aionui_db::models::AssistantSessionRow,
+    files: Vec<String>,
+) -> Result<(Vec<String>, PathBuf), std::io::Error> {
+    let workspace = inbound_workspace(work_dir, session);
+    let destination = workspace.join("微信文件");
+    tokio::fs::create_dir_all(&destination).await?;
+    let staging = tokio::fs::canonicalize(std::env::temp_dir().join("aionui-weixin-staging")).await?;
+    let mut archived = Vec::with_capacity(files.len());
+    for source in files {
+        let source = tokio::fs::canonicalize(source).await?;
+        if !source.starts_with(&staging) || !tokio::fs::symlink_metadata(&source).await?.file_type().is_file() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "untrusted WeChat staging file",
+            ));
+        }
+        let file_name = source.file_name().unwrap_or_default().to_string_lossy();
+        let mut target = destination.join(file_name.as_ref());
+        if tokio::fs::try_exists(&target).await? {
+            let stem = target.file_stem().unwrap_or_default().to_string_lossy();
+            let extension = target
+                .extension()
+                .map(|value| format!(".{}", value.to_string_lossy()))
+                .unwrap_or_default();
+            target = destination.join(format!("{stem}-{}{}", uuid::Uuid::new_v4().simple(), extension));
+        }
+        match tokio::fs::rename(&source, &target).await {
+            Ok(()) => {}
+            Err(_) => {
+                tokio::fs::copy(&source, &target).await?;
+                tokio::fs::remove_file(&source).await?;
+            }
+        }
+        archived.push(tokio::fs::canonicalize(target).await?.to_string_lossy().into_owned());
+    }
+    Ok((archived, workspace))
+}
