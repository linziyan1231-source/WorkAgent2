+/// Returns whether `workspace` is a user-visible project directory.
+///
+/// A project is deliberately narrower than "a conversation has a workspace":
+/// it must be a real, visible, direct child of the configured work directory.
+/// Auto-provisioned and legacy temporary workspaces therefore remain ordinary
+/// conversations and never become sidebar projects.
+pub fn is_project_workspace(work_dir: &Path, workspace: &Path) -> bool {
+    let Ok(metadata) = std::fs::symlink_metadata(workspace) else {
+        return false;
+    };
+    if !metadata.is_dir() || metadata.file_type().is_symlink() || metadata_is_hidden(&metadata) {
+        return false;
+    }
+
+    let Some(name) = workspace.file_name().and_then(|value| value.to_str()) else {
+        return false;
+    };
+    if name.starts_with('.')
+        || NON_PROJECT_WORKSPACE_NAMES
+            .iter()
+            .any(|reserved| name.eq_ignore_ascii_case(reserved))
+    {
+        return false;
+    }
+
+    let (Ok(canonical_root), Ok(canonical_workspace)) = (work_dir.canonicalize(), workspace.canonicalize()) else {
+        return false;
+    };
+    canonical_workspace.parent() == Some(canonical_root.as_path())
+}
+
+#[cfg(windows)]
+fn metadata_is_hidden(metadata: &std::fs::Metadata) -> bool {
+    use std::os::windows::fs::MetadataExt;
+
+    const FILE_ATTRIBUTE_HIDDEN: u32 = 0x2;
+    metadata.file_attributes() & FILE_ATTRIBUTE_HIDDEN != 0
+}
+
+#[cfg(not(windows))]
+fn metadata_is_hidden(_metadata: &std::fs::Metadata) -> bool {
+    false
