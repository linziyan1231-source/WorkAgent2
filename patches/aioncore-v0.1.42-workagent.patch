+        let root = self.root.clone();
+        tokio::task::spawn_blocking(move || load_session(&root, &normalized_id))
+            .await
+            .map_err(upload_join_error)?
+    }
+
+    pub async fn append_chunk(
+        &self,
+        upload_id: &str,
+        requested_offset: u64,
+        chunk: Vec<u8>,
+        expected_checksum: Option<[u8; 32]>,
+    ) -> Result<UploadSession, UploadError> {
+        if chunk.is_empty() {
+            return Err(UploadError::BadRequest("upload chunk must not be empty".to_owned()));
+        }
+        if chunk.len() > RESUMABLE_UPLOAD_CHUNK_SIZE {
+            return Err(UploadError::PayloadTooLarge(format!(
+                "upload chunk exceeds {RESUMABLE_UPLOAD_CHUNK_SIZE} bytes"
+            )));
+        }
+        let _chunk_slot = self
+            .chunk_slots
+            .clone()
+            .acquire_owned()
+            .await
+            .map_err(|_| UploadError::Internal("upload concurrency limiter is unavailable".to_owned()))?;
+        if let Some(expected) = expected_checksum {
+            let actual = Sha256::digest(&chunk);
+            if actual.as_slice() != expected {
+                return Err(UploadError::ChecksumMismatch(
+                    "upload chunk checksum does not match".to_owned(),
+                ));
+            }
+        }
+
+        let (normalized_id, lock) = self.session_lock(upload_id)?;
+        let _guard = lock.lock().await;
+        let root = self.root.clone();
+        tokio::task::spawn_blocking(move || {
+            let (metadata, payload_path, offset) = load_session_parts(&root, &normalized_id)?;
+            if requested_offset != offset {
+                return Err(UploadError::OffsetMismatch { expected: offset });
+            }
+            let chunk_len = u64::try_from(chunk.len())
+                .map_err(|_| UploadError::PayloadTooLarge("upload chunk is too large".to_owned()))?;
+            let new_offset = offset
+                .checked_add(chunk_len)
+                .ok_or_else(|| UploadError::PayloadTooLarge("upload offset overflow".to_owned()))?;
+            if new_offset > metadata.file_size {
+                return Err(UploadError::PayloadTooLarge(
+                    "upload chunk exceeds the declared file size".to_owned(),
+                ));
+            }
+
+            let mut payload = std::fs::OpenOptions::new()
+                .append(true)
+                .open(&payload_path)
+                .map_err(|error| UploadError::Internal(format!("cannot open upload payload: {error}")))?;
+            if let Err(error) = payload.write_all(&chunk).and_then(|_| payload.sync_data()) {
+                let _ = payload.set_len(offset);
+                return Err(UploadError::Internal(format!("cannot persist upload chunk: {error}")));
+            }
+            Ok(metadata_to_session(metadata, new_offset))
+        })
+        .await
+        .map_err(upload_join_error)?
+    }
+
+    pub async fn complete(&self, upload_id: &str) -> Result<String, UploadError> {
+        let (normalized_id, lock) = self.session_lock(upload_id)?;
+        let _guard = lock.lock().await;
+        let root = self.root.clone();
+        let completed_id = normalized_id.clone();
+        let path = tokio::task::spawn_blocking(move || {
+            if let Some(path) = read_completed_upload(&root, &normalized_id)? {
+                return Ok(path);
+            }
+            let (metadata, payload_path, offset) = load_session_parts(&root, &normalized_id)?;
+            if offset != metadata.file_size {
+                return Err(UploadError::BadRequest(format!(
+                    "upload is incomplete: expected {} bytes, received {offset}",
+                    metadata.file_size
+                )));
+            }
+
+            let final_dir = upload_final_directory(&root, metadata.conversation_id.as_deref())?;
+            std::fs::create_dir_all(&final_dir)
+                .map_err(|error| UploadError::Internal(format!("cannot create upload destination: {error}")))?;
+            let (base, extension) = split_base_ext(&metadata.file_name);
+            let mut candidate = metadata.file_name.clone();
+            for suffix in 2..=1001 {
+                let destination = final_dir.join(&candidate);
+                let completion_path = payload_path
+                    .parent()
+                    .ok_or_else(|| UploadError::Internal("upload session path has no parent".to_owned()))?
+                    .join(UPLOAD_SESSION_COMPLETION_FILE);
+                let encoded_destination = serde_json::to_vec(&destination.to_string_lossy().into_owned())
+                    .map_err(|error| UploadError::Internal(format!("cannot encode upload completion: {error}")))?;
+                std::fs::write(&completion_path, encoded_destination)
+                    .map_err(|error| UploadError::Internal(format!("cannot persist upload completion: {error}")))?;
+                match std::fs::hard_link(&payload_path, &destination) {
+                    Ok(()) => {
+                        std::fs::remove_file(&payload_path).map_err(|error| {
+                            UploadError::Internal(format!("cannot finalize upload payload: {error}"))
+                        })?;
+                        return Ok(destination.to_string_lossy().into_owned());
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {
+                        let _ = std::fs::remove_file(&completion_path);
+                        candidate = format!("{base}({suffix}){extension}");
+                    }
+                    Err(error) => {
+                        let _ = std::fs::remove_file(&completion_path);
+                        return Err(UploadError::Internal(format!(
+                            "cannot atomically finalize upload: {error}"
+                        )));
+                    }
+                }
+            }
+            Err(UploadError::Internal(format!(
+                "too many name collisions for upload file '{}'",
+                metadata.file_name
+            )))
+        })
+        .await
+        .map_err(upload_join_error)??;
