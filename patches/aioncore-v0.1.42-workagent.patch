+#[derive(Clone)]
+pub struct UploadService {
+    root: PathBuf,
+    session_locks: Arc<DashMap<String, Arc<Mutex<()>>>>,
+    create_lock: Arc<Mutex<()>>,
+    chunk_slots: Arc<Semaphore>,
