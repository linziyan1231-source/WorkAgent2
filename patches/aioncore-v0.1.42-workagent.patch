+        self.session_locks.remove(&completed_id);
+        info!(upload_id = %completed_id, "resumable upload completed");
+        Ok(path)
+    }
+
+    pub async fn cancel(&self, upload_id: &str) -> Result<(), UploadError> {
+        let (normalized_id, lock) = self.session_lock(upload_id)?;
+        let _guard = lock.lock().await;
+        let root = self.root.clone();
+        let removed_id = normalized_id.clone();
+        tokio::task::spawn_blocking(move || {
+            let session_dir = session_directory(&root, &normalized_id)?;
+            if !session_dir.is_dir() {
+                return Err(UploadError::NotFound("upload session not found".to_owned()));
+            }
+            std::fs::remove_dir_all(session_dir)
+                .map_err(|error| UploadError::Internal(format!("cannot remove upload session: {error}")))
+        })
+        .await
+        .map_err(upload_join_error)??;
+        self.session_locks.remove(&removed_id);
+        Ok(())
+    }
+
+    fn session_lock(&self, upload_id: &str) -> Result<(String, Arc<Mutex<()>>), UploadError> {
+        let normalized_id = normalize_upload_id(upload_id)?;
+        let lock = self
+            .session_locks
+            .entry(normalized_id.clone())
+            .or_insert_with(|| Arc::new(Mutex::new(())))
+            .clone();
+        Ok((normalized_id, lock))
+    }
+}
