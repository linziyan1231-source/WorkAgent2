+    async fn quota_summary(&self) -> String {
+        let mut lines = Vec::new();
+        let mut quota_disk_remaining = None;
+        let snapshot_path = std::env::var_os("AIONUI_DATA_DIR")
+            .map(PathBuf::from)
+            .unwrap_or_else(|| self.work_dir.clone())
+            .join("quota-summary.json");
+        if let Ok(content) = tokio::fs::read_to_string(&snapshot_path).await
+            && let Ok(snapshot) = serde_json::from_str::<serde_json::Value>(&content)
+        {
+            quota_disk_remaining = snapshot
+                .get("storage")
+                .and_then(|storage| storage.get("remaining_bytes"))
+                .and_then(serde_json::Value::as_u64);
+            for (kind, label) in [("chatgpt", "ChatGPT"), ("kimi", "Kimi")] {
+                if let Some(provider) = snapshot
+                    .get("providers")
+                    .and_then(serde_json::Value::as_array)
+                    .and_then(|providers| {
+                        providers
+                            .iter()
+                            .find(|provider| provider.get("kind").and_then(serde_json::Value::as_str) == Some(kind))
+                    })
+                {
+                    let daily = provider.get("daily").unwrap_or(&serde_json::Value::Null);
+                    let weekly = provider.get("weekly").unwrap_or(&serde_json::Value::Null);
+                    lines.push(format!(
+                        "{label}：今日剩余 ${} / ${}；本周剩余 ${} / ${}",
+                        daily
+                            .get("remaining_usd")
+                            .and_then(serde_json::Value::as_str)
+                            .unwrap_or("--"),
+                        daily
+                            .get("limit_usd")
+                            .and_then(serde_json::Value::as_str)
+                            .unwrap_or("--"),
+                        weekly
+                            .get("remaining_usd")
+                            .and_then(serde_json::Value::as_str)
+                            .unwrap_or("--"),
+                        weekly
+                            .get("limit_usd")
+                            .and_then(serde_json::Value::as_str)
+                            .unwrap_or("--")
+                    ));
+                }
+            }
+        }
+        if lines.len() < 2 {
+            lines = vec!["ChatGPT：额度数据暂不可用".into(), "Kimi：额度数据暂不可用".into()];
+        }
+        let disk = quota_disk_remaining
+            .map(format_bytes)
+            .or_else(|| fs2::available_space(&self.work_dir).ok().map(format_bytes))
+            .unwrap_or_else(|| "暂不可用".into());
+        lines.push(format!("硬盘可用空间：{disk}"));
+        lines.join("\n")
+    }
+}
