+impl UploadService {
+    pub fn new(root: PathBuf) -> Self {
+        Self {
+            root,
+            session_locks: Arc::new(DashMap::new()),
+            create_lock: Arc::new(Mutex::new(())),
+            chunk_slots: Arc::new(Semaphore::new(RESUMABLE_UPLOAD_MAX_CONCURRENT_CHUNKS)),
+        }
+    }
