+#[derive(Default)]
+struct ActiveUploadReservations {
+    bytes: u64,
+}
+
+fn active_upload_reservations(root: &Path) -> Result<ActiveUploadReservations, UploadError> {
+    let mut reservations = ActiveUploadReservations::default();
+    for entry in std::fs::read_dir(root)
+        .map_err(|error| UploadError::Internal(format!("cannot inspect upload sessions: {error}")))?
+    {
+        let entry =
+            entry.map_err(|error| UploadError::Internal(format!("cannot inspect upload session entry: {error}")))?;
+        if !entry
+            .file_type()
+            .map_err(|error| UploadError::Internal(format!("cannot inspect upload session type: {error}")))?
+            .is_dir()
+        {
+            continue;
+        }
+        let Ok(metadata) = read_upload_metadata(&entry.path()) else {
+            continue;
+        };
+        if read_completed_upload(root, &metadata.upload_id)?.is_some() {
+            continue;
+        }
+        reservations.bytes = reservations.bytes.checked_add(metadata.file_size).ok_or_else(|| {
+            UploadError::CapacityExceeded("active upload reservation exceeds the configured limit".to_owned())
+        })?;
+    }
+    Ok(reservations)
+}
