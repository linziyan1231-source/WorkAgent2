+    pub async fn create_session(
+        &self,
+        file_name: String,
+        file_size: u64,
+        conversation_id: Option<String>,
+        fingerprint: Option<String>,
+        client_request_id: Option<String>,
+    ) -> Result<UploadSession, UploadError> {
+        validate_upload_component("file name", &file_name)?;
+        if file_size > RESUMABLE_UPLOAD_MAX_SIZE {
+            return Err(UploadError::PayloadTooLarge(format!(
+                "file exceeds the {} byte upload limit",
+                RESUMABLE_UPLOAD_MAX_SIZE
+            )));
+        }
+
+        let conversation_id = normalize_optional_component("conversation id", conversation_id)?;
+        let fingerprint = fingerprint.and_then(|value| {
+            let trimmed = value.trim();
+            (!trimmed.is_empty()).then(|| trimmed.to_owned())
+        });
+        if fingerprint.as_ref().is_some_and(|value| value.len() > 256) {
+            return Err(UploadError::BadRequest("fingerprint is too long".to_owned()));
+        }
+        if fingerprint.as_ref().is_some_and(|value| {
+            !value
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'+' | b'/' | b'=' | b'-' | b'_'))
+        }) {
+            return Err(UploadError::BadRequest(
+                "fingerprint contains invalid characters".to_owned(),
+            ));
+        }
+        let client_request_id = normalize_client_request_id(client_request_id)?;
+
+        let _create_guard = self.create_lock.lock().await;
+        let root = self.root.clone();
+        let metadata = tokio::task::spawn_blocking(move || {
+            std::fs::create_dir_all(&root)
+                .map_err(|error| UploadError::Internal(format!("cannot create upload session directory: {error}")))?;
+            cleanup_expired_sessions(&root)?;
+
+            if let Some(existing) = find_upload_by_client_request(
+                &root,
+                client_request_id.as_deref(),
+                &file_name,
+                file_size,
+                conversation_id.as_deref(),
+                fingerprint.as_deref(),
+            )? {
+                return Ok(existing);
+            }
+
+            let active = active_upload_reservations(&root)?;
+            let reserved = active.bytes.checked_add(file_size).ok_or_else(|| {
+                UploadError::CapacityExceeded("active upload reservation exceeds the configured limit".to_owned())
+            })?;
+            if reserved > RESUMABLE_UPLOAD_MAX_RESERVED_BYTES {
+                return Err(UploadError::CapacityExceeded(format!(
+                    "active uploads may reserve at most {RESUMABLE_UPLOAD_MAX_RESERVED_BYTES} bytes"
+                )));
+            }
+
+            let upload_id = Uuid::now_v7().to_string();
+            let session_dir = root.join(&upload_id);
+            std::fs::create_dir(&session_dir)
+                .map_err(|error| UploadError::Internal(format!("cannot create upload session: {error}")))?;
+
+            let expires_at_unix_ms =
+                now_unix_ms().saturating_add(RESUMABLE_UPLOAD_SESSION_TTL_SECS.saturating_mul(1000));
+            let metadata = UploadSessionMetadata {
+                upload_id,
+                file_name,
+                file_size,
+                conversation_id,
+                fingerprint,
+                client_request_id,
+                expires_at_unix_ms,
+            };
+
+            let result = (|| {
+                let payload_path = session_dir.join(UPLOAD_SESSION_PAYLOAD_FILE);
+                std::fs::OpenOptions::new()
+                    .write(true)
+                    .create_new(true)
+                    .open(payload_path)
+                    .map_err(|error| UploadError::Internal(format!("cannot create upload payload: {error}")))?;
+
+                let encoded = serde_json::to_vec(&metadata)
+                    .map_err(|error| UploadError::Internal(format!("cannot encode upload session: {error}")))?;
+                std::fs::write(session_dir.join(UPLOAD_SESSION_METADATA_FILE), encoded)
+                    .map_err(|error| UploadError::Internal(format!("cannot persist upload session: {error}")))?;
+                Ok((metadata.clone(), 0))
+            })();
+            if result.is_err() {
+                let _ = std::fs::remove_dir_all(&session_dir);
+            }
