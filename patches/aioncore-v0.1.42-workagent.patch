new file mode 100644
index 0000000000000000000000000000000000000000..b40349630bc424378d26eaf3b682c867817822e0
--- /dev/null
+++ b/crates/aionui-channel/src/command.rs
@@ -0,0 +1,876 @@
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::SystemTime;
+
+use aionui_ai_agent::IWorkerTaskManager;
+use aionui_api_types::{ListConversationsQuery, ListMessagesQuery, SetConfigOptionRequest, UpdateConversationRequest};
+use aionui_common::{AgentKillReason, MessagePosition};
+use aionui_conversation::ConversationService;
+use aionui_db::models::AssistantSessionRow;
+use tokio::sync::Mutex;
+use tracing::info;
+
+use crate::error::ChannelError;
+use crate::session::SessionManager;
+use crate::types::PluginType;
+
+const DEFAULT_HISTORY_LIMIT: u32 = 10;
+const MAX_HISTORY_LIMIT: u32 = 30;
+const MAX_CONVERSATION_LIST: u32 = 100;
+const DISPLAY_CONVERSATION_LIMIT: usize = 10;
+const DISPLAY_PROJECT_LIMIT: usize = 10;
+
+/// Commands owned by the IM channel layer.
+///
+/// Only the Chinese names below are intercepted. ASCII slash commands remain
+/// untouched and are sent to the selected CLI runtime.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ChannelCommand {
+    New { project: Option<String> },
+    Switch { target: Option<String> },
+    History { limit: u32 },
+    Model { target: Option<String> },
+    Continue,
+    Compact,
+    Rename { name: Option<String> },
+    Quota,
+    Help { unknown: Option<String> },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum PendingSelection {
+    Project,
+    Conversation,
+    Model,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum PendingCommandResolution {
+    Command(ChannelCommand),
+    Exit,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CommandExecution {
+    Reply(String),
+    Dispatch(String),
+}
+
+pub fn parse_channel_command(text: &str) -> Option<ChannelCommand> {
+    let trimmed = text.trim();
+    let rest = trimmed.strip_prefix('/')?;
+    let (name, argument) = rest
+        .split_once(char::is_whitespace)
+        .map_or((rest, None), |(name, value)| (name, Some(value.trim())));
+    let argument = argument.filter(|value| !value.is_empty()).map(str::to_owned);
+
+    let canonical = [
+        "新对话",
+        "切换",
+        "历史",
+        "模型",
+        "继续",
+        "压缩",
+        "重命名",
+        "额度",
+        "帮助",
+        "指令",
+    ]
+    .into_iter()
+    .filter(|candidate| candidate.starts_with(name))
+    .collect::<Vec<_>>();
+    let resolved = match canonical.as_slice() {
+        [only] => *only,
+        _ => name,
+    };
+
+    match resolved {
+        "新对话" => Some(ChannelCommand::New { project: argument }),
+        "切换" => Some(ChannelCommand::Switch { target: argument }),
+        "历史" => {
+            let limit = argument
+                .as_deref()
+                .and_then(|value| value.parse::<u32>().ok())
+                .unwrap_or(DEFAULT_HISTORY_LIMIT)
+                .clamp(1, MAX_HISTORY_LIMIT);
+            Some(ChannelCommand::History { limit })
+        }
+        "模型" => Some(ChannelCommand::Model { target: argument }),
+        "继续" => Some(ChannelCommand::Continue),
+        "压缩" => Some(ChannelCommand::Compact),
+        "重命名" => Some(ChannelCommand::Rename { name: argument }),
+        "额度" => Some(ChannelCommand::Quota),
+        "帮助" | "指令" => Some(ChannelCommand::Help { unknown: None }),
+        _ if name.chars().any(is_cjk) => Some(ChannelCommand::Help {
+            unknown: Some(format!("/{name}")),
+        }),
+        _ => None,
+    }
+}
+
+fn is_cjk(character: char) -> bool {
+    matches!(
+        character as u32,
+        0x3400..=0x4DBF | 0x4E00..=0x9FFF | 0xF900..=0xFAFF
+    )
+}
+
+pub struct ChannelCommandService {
+    conversation_svc: Arc<ConversationService>,
+    task_manager: Arc<dyn IWorkerTaskManager>,
+    owner_user_id: String,
+    work_dir: PathBuf,
+    pending: Mutex<HashMap<String, PendingSelection>>,
+}
+
+impl ChannelCommandService {
+    pub fn new(
+        conversation_svc: Arc<ConversationService>,
+        task_manager: Arc<dyn IWorkerTaskManager>,
+        owner_user_id: String,
+        work_dir: PathBuf,
+    ) -> Self {
+        Self {
+            conversation_svc,
+            task_manager,
+            owner_user_id,
+            work_dir,
+            pending: Mutex::new(HashMap::new()),
+        }
+    }
+
+    pub async fn resolve_pending_input(
+        &self,
+        session: &AssistantSessionRow,
+        input: &str,
+        platform: PluginType,
+    ) -> Result<Option<PendingCommandResolution>, ChannelError> {
+        let Some(kind) = self.pending.lock().await.get(&session.id).copied() else {
+            return Ok(None);
+        };
+        let input = input.trim();
+        let exit_index = match kind {
+            PendingSelection::Project => self.list_projects().await?.len() + 1,
+            PendingSelection::Conversation => {
+                self.conversations_for_chat(session, platform)
+                    .await?
+                    .len()
+                    .min(DISPLAY_CONVERSATION_LIMIT)
+                    + 1
+            }
+            PendingSelection::Model => self
+                .model_options(session)
+                .await?
+                .map_or(1, |options| options.options.len() + 1),
+        };
+        if input.eq_ignore_ascii_case("退出") || input == exit_index.to_string() {
+            self.pending.lock().await.remove(&session.id);
+            return Ok(Some(PendingCommandResolution::Exit));
+        }
+        let command = match kind {
+            PendingSelection::Project => ChannelCommand::New {
+                project: Some(input.to_owned()),
+            },
+            PendingSelection::Conversation => ChannelCommand::Switch {
+                target: Some(input.to_owned()),
+            },
+            PendingSelection::Model => ChannelCommand::Model {
+                target: Some(input.to_owned()),
+            },
+        };
+        Ok(Some(PendingCommandResolution::Command(command)))
+    }
+
+    pub async fn execute(
+        &self,
+        command: ChannelCommand,
+        session: &AssistantSessionRow,
+        platform: PluginType,
+        session_manager: &SessionManager,
+    ) -> Result<CommandExecution, ChannelError> {
+        match command {
+            ChannelCommand::New { project } => self.new_conversation(session, project, session_manager).await,
+            ChannelCommand::Switch { target } => {
+                self.switch_conversation(session, platform, target, session_manager)
+                    .await
+            }
+            ChannelCommand::History { limit } => self.history(session, limit).await,
+            ChannelCommand::Model { target } => self.model(session, target).await,
+            ChannelCommand::Continue => self.continue_conversation(session, platform, session_manager).await,
+            ChannelCommand::Compact => {
+                if session.conversation_id.is_none() {
+                    Ok(CommandExecution::Reply(
+                        "当前没有可压缩的对话，请先发送一条消息。".into(),
+                    ))
+                } else {
+                    Ok(CommandExecution::Dispatch("/compact".into()))
+                }
+            }
+            ChannelCommand::Rename { name } => self.rename(session, name).await,
+            ChannelCommand::Quota => Ok(CommandExecution::Reply(self.quota_summary().await)),
+            ChannelCommand::Help { unknown } => Ok(CommandExecution::Reply(command_help(unknown.as_deref()))),
+        }
+    }
+
+    async fn new_conversation(
+        &self,
+        session: &AssistantSessionRow,
+        project: Option<String>,
+        session_manager: &SessionManager,
+    ) -> Result<CommandExecution, ChannelError> {
+        let Some(project) = project else {
+            self.pending
+                .lock()
+                .await
+                .insert(session.id.clone(), PendingSelection::Project);
+            return Ok(CommandExecution::Reply(self.project_help().await?));
+        };
+        let workspace = if matches!(project.as_str(), "0" | "无项目" | "临时" | "none") {
+            None
+        } else {
+            match self.resolve_project(&project).await {
+                Ok(workspace) => Some(workspace),
+                Err(error) => {
+                    self.pending
+                        .lock()
+                        .await
+                        .insert(session.id.clone(), PendingSelection::Project);
+                    return Ok(CommandExecution::Reply(format!(
+                        "{error}\n\n{}",
+                        self.project_help().await?
+                    )));
+                }
+            }
+        };
+        self.pending.lock().await.remove(&session.id);
+        let chat_id = session
+            .chat_id
+            .as_deref()
+            .ok_or_else(|| ChannelError::InvalidConfig("Channel session has no chat_id".into()))?;
+        let fresh = session_manager
+            .reset_session(
+                &session.user_id,
+                chat_id,
+                &session.agent_type,
+                workspace.as_deref().and_then(Path::to_str),
+            )
+            .await?;
+        info!(
+            session_id = %fresh.id,
+            has_project = workspace.is_some(),
+            "Channel command created a new conversation session"
+        );
+        let project_label = workspace
+            .as_deref()
+            .and_then(Path::file_name)
+            .map(|value| value.to_string_lossy().into_owned())
+            .unwrap_or_else(|| "无项目（临时工作区）".into());
+        Ok(CommandExecution::Reply(format!(
+            "已新建对话。\n项目：{project_label}\n发送消息后会创建正式对话记录。"
+        )))
+    }
+
+    async fn project_help(&self) -> Result<String, ChannelError> {
+        let projects = self.list_projects().await?;
+        let mut lines = vec![
+            "新对话需要选择项目：".to_owned(),
+            "0. 无项目（使用临时工作区）".to_owned(),
+        ];
+        lines.extend(
+            projects
+                .iter()
+                .enumerate()
+                .map(|(index, path)| format!("{}. {}", index + 1, project_name(path))),
+        );
+        lines.push(format!("{}. 退出", projects.len() + 1));
+        lines.push("请直接回复编号或项目名称。".into());
+        Ok(lines.join("\n"))
+    }
+
+    async fn list_projects(&self) -> Result<Vec<PathBuf>, ChannelError> {
+        let mut reader = tokio::fs::read_dir(&self.work_dir)
+            .await
+            .map_err(|error| ChannelError::PlatformApi(format!("Failed to list projects: {error}")))?;
+        let mut projects = Vec::new();
+        while let Some(entry) = reader
+            .next_entry()
+            .await
+            .map_err(|error| ChannelError::PlatformApi(format!("Failed to list projects: {error}")))?
+        {
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if name.starts_with('.')
+                || matches!(
+                    name.to_ascii_lowercase().as_str(),
+                    "conversations"
+                        | "inbound"
+                        | "sessions"
+                        | "skills"
+                        | "runtime"
+                        | "builtin-skills"
+                        | "aionrs-sessions"
+                )
+            {
+                continue;
+            }
+            let metadata = tokio::fs::symlink_metadata(entry.path())
+                .await
+                .map_err(|error| ChannelError::PlatformApi(format!("Failed to inspect project: {error}")))?;
+            if metadata.is_dir() && !metadata.file_type().is_symlink() {
+                projects.push((metadata.modified().unwrap_or(SystemTime::UNIX_EPOCH), entry.path()));
+            }
+        }
+        projects.sort_by(|left, right| {
+            right.0.cmp(&left.0).then_with(|| {
+                project_name(&left.1)
+                    .to_lowercase()
+                    .cmp(&project_name(&right.1).to_lowercase())
+            })
+        });
+        Ok(projects
+            .into_iter()
+            .take(DISPLAY_PROJECT_LIMIT)
+            .map(|(_, path)| path)
+            .collect())
+    }
+
+    async fn resolve_project(&self, target: &str) -> Result<PathBuf, ChannelError> {
+        let projects = self.list_projects().await?;
+        if let Ok(index) = target.parse::<usize>()
+            && index > 0
+            && let Some(project) = projects.get(index - 1)
+        {
+            return Ok(project.clone());
+        }
+        let matching = projects
+            .into_iter()
+            .filter(|path| project_name(path).eq_ignore_ascii_case(target))
+            .collect::<Vec<_>>();
+        match matching.as_slice() {
+            [project] => Ok(project.clone()),
+            [] => Err(ChannelError::InvalidConfig(format!(
+                "没有找到项目“{target}”。请发送 /新对话 查看可用项目。"
+            ))),
+            _ => Err(ChannelError::InvalidConfig(format!(
+                "项目名“{target}”不唯一，请发送 /新对话 后用编号选择。"
+            ))),
+        }
+    }
+
+    async fn conversations_for_chat(
+        &self,
+        _session: &AssistantSessionRow,
+        _platform: PluginType,
+    ) -> Result<Vec<aionui_api_types::ConversationResponse>, ChannelError> {
+        let mut items = self
+            .conversation_svc
+            .list(
+                &self.owner_user_id,
+                ListConversationsQuery {
+                    limit: Some(MAX_CONVERSATION_LIST),
+                    ..Default::default()
+                },
+            )
+            .await
+            .map_err(|error| ChannelError::PlatformApi(error.to_string()))?
+            .items
+            .into_iter()
+            .collect::<Vec<_>>();
+        items.sort_by_key(|conversation| std::cmp::Reverse(conversation.modified_at));
+        Ok(items)
+    }
+
+    async fn switch_conversation(
+        &self,
+        session: &AssistantSessionRow,
+        platform: PluginType,
+        target: Option<String>,
+        session_manager: &SessionManager,
+    ) -> Result<CommandExecution, ChannelError> {
+        let conversations = self.conversations_for_chat(session, platform).await?;
+        let Some(target) = target else {
+            self.pending
+                .lock()
+                .await
+                .insert(session.id.clone(), PendingSelection::Conversation);
+            return Ok(CommandExecution::Reply(format_conversation_list(
+                &conversations[..conversations.len().min(DISPLAY_CONVERSATION_LIMIT)],
+                session.conversation_id.as_deref(),
+            )));
+        };
+        let displayed = &conversations[..conversations.len().min(DISPLAY_CONVERSATION_LIMIT)];
+        let candidates = if target.parse::<usize>().is_ok() {
+            displayed
+        } else {
+            conversations.as_slice()
+        };
+        let conversation = match resolve_conversation_target(candidates, &target) {
+            Ok(conversation) => conversation,
+            Err(error) => {
+                self.pending
+                    .lock()
+                    .await
+                    .insert(session.id.clone(), PendingSelection::Conversation);
+                return Ok(CommandExecution::Reply(format!(
+                    "{error}\n\n{}",
+                    format_conversation_list(displayed, session.conversation_id.as_deref())
+                )));
+            }
+        };
+        self.pending.lock().await.remove(&session.id);
+        session_manager.bind_conversation(&session.id, &conversation.id).await?;
+        Ok(CommandExecution::Reply(format!(
+            "已切换至：{}\n对话 ID：{}",
+            conversation.name,
+            short_id(&conversation.id)
+        )))
+    }
+
+    async fn continue_conversation(
+        &self,
+        session: &AssistantSessionRow,
+        platform: PluginType,
+        session_manager: &SessionManager,
+    ) -> Result<CommandExecution, ChannelError> {
+        let conversations = self.conversations_for_chat(session, platform).await?;
+        if let Some(cutover) = session_manager.take_idle_cutover(&session.id).await {
+            let Some(previous) = conversations
+                .iter()
+                .find(|conversation| conversation.id == cutover.previous_conversation_id)
+            else {
+                return Ok(CommandExecution::Reply("自动切换前的对话已不存在，无法恢复。".into()));
+            };
+            let deleted_auto_conversation = cutover.auto_conversation_id.is_some();
+            if let Some(auto_conversation_id) = cutover.auto_conversation_id.as_deref() {
+                self.task_manager
+                    .kill_and_wait(auto_conversation_id, Some(AgentKillReason::ConversationDeleted))
+                    .await;
+                self.conversation_svc
+                    .delete(&self.owner_user_id, auto_conversation_id)
+                    .await
+                    .map_err(|error| ChannelError::PlatformApi(error.to_string()))?;
+            }
+            session_manager.bind_conversation(&session.id, &previous.id).await?;
+            return Ok(CommandExecution::Reply(if deleted_auto_conversation {
+                format!(
+                    "已停止并删除自动创建的新对话，并恢复：{}\n请重新发送刚才的指令。",
+                    previous.name
+                )
+            } else {
+                format!("已恢复：{}\n请重新发送刚才的指令。", previous.name)
+            }));
+        }
+        let previous = conversations
+            .iter()
+            .find(|conversation| Some(conversation.id.as_str()) != session.conversation_id.as_deref());
+        let Some(previous) = previous else {
+            return Ok(CommandExecution::Reply(
+                "没有可恢复的上一个对话。可发送 /切换 查看全部对话。".into(),
+            ));
+        };
+        session_manager.bind_conversation(&session.id, &previous.id).await?;
+        Ok(CommandExecution::Reply(format!(
+            "已恢复上一个对话：{}\n对话 ID：{}",
+            previous.name,
+            short_id(&previous.id)
+        )))
+    }
+
+    async fn history(&self, session: &AssistantSessionRow, limit: u32) -> Result<CommandExecution, ChannelError> {
+        let Some(conversation_id) = session.conversation_id.as_deref() else {
+            return Ok(CommandExecution::Reply("当前是空白新对话，还没有历史消息。".into()));
+        };
+        let response = self
+            .conversation_svc
+            .list_messages(
+                &self.owner_user_id,
+                conversation_id,
+                ListMessagesQuery {
+                    limit: Some(limit),
+                    content_mode: Some("compact".into()),
+                    ..Default::default()
+                },
+            )
+            .await
+            .map_err(|error| ChannelError::PlatformApi(error.to_string()))?;
+        let mut lines = vec![format!("当前对话最近 {} 条消息：", response.items.len())];
+        for message in response.items {
+            let Some(text) = message_text(&message.content) else {
+                continue;
+            };
+            let speaker = match message.position {
+                Some(MessagePosition::Right) => "你",
+                Some(MessagePosition::Left) => "助手",
+                _ => "系统",
+            };
+            lines.push(format!("{speaker}：{}", truncate_chars(text.trim(), 500)));
+        }
+        if lines.len() == 1 {
+            lines.push("暂无可显示的文本消息。".into());
+        }
+        Ok(CommandExecution::Reply(lines.join("\n\n")))
+    }
+
+    async fn rename(
+        &self,
+        session: &AssistantSessionRow,
+        name: Option<String>,
+    ) -> Result<CommandExecution, ChannelError> {
+        let Some(conversation_id) = session.conversation_id.as_deref() else {
+            return Ok(CommandExecution::Reply(
+                "当前还没有正式对话，发送消息后再重命名。".into(),
+            ));
+        };
+        let Some(name) = name
+            .map(|value| value.trim().to_owned())
+            .filter(|value| !value.is_empty())
+        else {
+            return Ok(CommandExecution::Reply("用法：/重命名 新名称".into()));
+        };
+        if name.chars().count() > 100 {
+            return Ok(CommandExecution::Reply("对话名称不能超过 100 个字符。".into()));
+        }
+        self.conversation_svc
+            .update(
+                &self.owner_user_id,
+                conversation_id,
+                UpdateConversationRequest {
+                    name: Some(name.clone()),
+                    pinned: None,
+                    model: None,
+                    extra: None,
+                },
+                &self.task_manager,
+            )
+            .await
+            .map_err(|error| ChannelError::PlatformApi(error.to_string()))?;
+        Ok(CommandExecution::Reply(format!("当前对话已重命名为：{name}")))
+    }
+
+    async fn model(
+        &self,
+        session: &AssistantSessionRow,
+        target: Option<String>,
+    ) -> Result<CommandExecution, ChannelError> {
+        let Some(conversation_id) = session.conversation_id.as_deref() else {
+            return Ok(CommandExecution::Reply(
+                "当前还没有正式对话，发送消息后再选择模型。".into(),
+            ));
+        };
+        let Some(model_option) = self.model_options(session).await? else {
+            return Ok(CommandExecution::Reply("当前助手不支持在对话中切换模型。".into()));
+        };
+        let Some(target) = target else {
+            self.pending
+                .lock()
+                .await
+                .insert(session.id.clone(), PendingSelection::Model);
+            return Ok(CommandExecution::Reply(format_model_list(&model_option)));
+        };
+        let selected = match resolve_model_target(&model_option.options, &target) {
+            Ok(selected) => selected,
+            Err(error) => {
+                self.pending
+                    .lock()
+                    .await
+                    .insert(session.id.clone(), PendingSelection::Model);
+                return Ok(CommandExecution::Reply(format!(
+                    "{error}\n\n{}",
+                    format_model_list(&model_option)
+                )));
+            }
+        };
+        self.pending.lock().await.remove(&session.id);
+        let response = self
+            .conversation_svc
+            .set_config_option(
+                conversation_id,
+                "model",
+                SetConfigOptionRequest {
+                    value: selected.value.clone(),
+                },
+            )
+            .await
+            .map_err(|error| ChannelError::PlatformApi(error.to_string()))?;
+        info!(
+            conversation_id,
+            confirmation = ?response.confirmation,
+            "Channel command switched conversation model"
+        );
+        Ok(CommandExecution::Reply(format!(
+            "模型已切换为：{}",
+            selected
+                .label
+                .as_deref()
+                .or(selected.name.as_deref())
+                .unwrap_or(&selected.value)
+        )))
+    }
+
+    async fn model_options(
+        &self,
+        session: &AssistantSessionRow,
+    ) -> Result<Option<aionui_api_types::AcpConfigOptionDto>, ChannelError> {
+        let Some(conversation_id) = session.conversation_id.as_deref() else {
+            return Ok(None);
+        };
+        let runtime = self
+            .conversation_svc
+            .ensure_runtime(&self.owner_user_id, conversation_id, &self.task_manager)
+            .await
+            .map_err(|error| ChannelError::PlatformApi(error.to_string()))?;
+        Ok(runtime.config_options.into_iter().find(|option| option.id == "model"))
+    }
