# Install as /etc/workagent/chatforward.env, owned by root and mode 0640.
# Secrets do not belong here; both Portal and ChatForward load the same encrypted
# chatforward-key credential through systemd.
CHATFORWARD_PORTAL_URL=http://127.0.0.1:42580
CHATFORWARD_MIRROR_URL=https://workagent.example.invalid/chatgpt/
CHATFORWARD_CHROMIUM_BIN=/usr/bin/google-chrome-stable
CHATFORWARD_XVFB_BIN=/usr/bin/Xvfb
CHATFORWARD_XAUTH_BIN=/usr/bin/xauth
CHATFORWARD_DISPLAY=:77
# This host's approved loopback egress boundary. It is intentionally explicit;
# the launchers clear ambient proxy variables and bypass it for local services.
CHATFORWARD_OUTBOUND_PROXY_URL=http://127.0.0.1:8118
