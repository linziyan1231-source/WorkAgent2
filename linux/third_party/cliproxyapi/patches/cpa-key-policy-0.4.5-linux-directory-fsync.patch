diff --git a/internal/policy/replace_file.go b/internal/policy/replace_file.go
--- a/internal/policy/replace_file.go
+++ b/internal/policy/replace_file.go
@@ -2,8 +2,31 @@
 
 package policy
 
-import "os"
+import (
+	"os"
+	"path/filepath"
+)
 
 func replaceFile(from, to string) error {
-	return os.Rename(from, to)
+	return replaceFileAndSync(from, to, os.Rename, syncDirectory)
+}
+
+func replaceFileAndSync(
+	from, to string,
+	renameFile func(string, string) error,
+	syncParent func(string) error,
+) error {
+	if err := renameFile(from, to); err != nil {
+		return err
+	}
+	return syncParent(filepath.Dir(to))
+}
+
+func syncDirectory(path string) error {
+	directory, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer directory.Close()
+	return directory.Sync()
 }
diff --git a/internal/policy/replace_file_test.go b/internal/policy/replace_file_test.go
new file mode 100644
--- /dev/null
+++ b/internal/policy/replace_file_test.go
@@ -0,0 +1,76 @@
+//go:build !windows
+
+package policy
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestReplaceFileAndSyncUsesDestinationParentAfterRename(t *testing.T) {
+	var calls []string
+	err := replaceFileAndSync(
+		"/state/.state.json.partial",
+		"/state/state.json",
+		func(from, to string) error {
+			calls = append(calls, "rename:"+from+":"+to)
+			return nil
+		},
+		func(path string) error {
+			calls = append(calls, "sync:"+path)
+			return nil
+		},
+	)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{
+		"rename:/state/.state.json.partial:/state/state.json",
+		"sync:/state",
+	}
+	if !reflect.DeepEqual(calls, want) {
+		t.Fatalf("replace/sync calls = %v, want %v", calls, want)
+	}
+}
+
+func TestReplaceFileAndSyncPropagatesDirectorySyncFailure(t *testing.T) {
+	wantErr := errors.New("directory sync failed")
+	renamed := false
+	err := replaceFileAndSync("from", "to", func(_, _ string) error {
+		renamed = true
+		return nil
+	}, func(string) error {
+		return wantErr
+	})
+	if !renamed || !errors.Is(err, wantErr) {
+		t.Fatalf("renamed = %t, error = %v", renamed, err)
+	}
+}
+
+func TestReplaceFileReplacesDestinationAndSyncsActualDirectory(t *testing.T) {
+	directory := t.TempDir()
+	from := filepath.Join(directory, "state.partial")
+	to := filepath.Join(directory, "state.json")
+	if err := os.WriteFile(from, []byte("new state"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(to, []byte("old state"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := replaceFile(from, to); err != nil {
+		t.Fatal(err)
+	}
+	payload, err := os.ReadFile(to)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(payload) != "new state" {
+		t.Fatalf("destination payload = %q", payload)
+	}
+	if _, err := os.Stat(from); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("temporary source still exists: %v", err)
+	}
+}
