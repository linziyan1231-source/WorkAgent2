diff --git a/internal/policy/replace_file_windows.go b/internal/policy/replace_file_windows.go
new file mode 100644
--- /dev/null
+++ b/internal/policy/replace_file_windows.go
@@ -0,0 +1,50 @@
+//go:build windows
+
+package policy
+
+import (
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+const (
+	moveFileReplaceExisting = 0x1
+	moveFileWriteThrough    = 0x8
+	errorSharingViolation   = syscall.Errno(32)
+)
+
+var moveFileExW = syscall.NewLazyDLL("kernel32.dll").NewProc("MoveFileExW")
+
+func replaceFile(from, to string) error {
+	fromPtr, err := syscall.UTF16PtrFromString(from)
+	if err != nil {
+		return err
+	}
+	toPtr, err := syscall.UTF16PtrFromString(to)
+	if err != nil {
+		return err
+	}
+	for attempt := 0; attempt < 10; attempt++ {
+		result, _, callErr := moveFileExW.Call(
+			uintptr(unsafe.Pointer(fromPtr)),
+			uintptr(unsafe.Pointer(toPtr)),
+			moveFileReplaceExisting|moveFileWriteThrough,
+		)
+		if result != 0 {
+			return nil
+		}
+		errno, ok := callErr.(syscall.Errno)
+		if !ok || (errno != syscall.ERROR_ACCESS_DENIED && errno != errorSharingViolation) {
+			if callErr != nil && callErr != syscall.Errno(0) {
+				return callErr
+			}
+			return syscall.EINVAL
+		}
+		if attempt == 9 {
+			return errno
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	return syscall.EINVAL
+}
