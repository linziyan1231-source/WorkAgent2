+func TestConcurrentAliasPersistAndUsageFlushRemainConsistent(t *testing.T) {
+	store, _ := newTestStore(t)
+	path := store.StatePath()
+	for i := 0; i < 50; i++ {
+		aliasName := "concurrent-" + itoa(i)
+		start := make(chan struct{})
+		errs := make(chan error, 2)
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			<-start
+			errs <- store.UpsertAlias(AliasMapping{
+				Alias:                    aliasName,
+				Targets:                  []AliasTarget{{Provider: "kimi", TargetModel: "kimi-k3"}},
+				BillingMode:              "tokens",
+				InputPricePerMillion:     3,
+				OutputPricePerMillion:    15,
+				CacheReadPricePerMillion: 0.3,
+			})
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			errs <- store.FlushUsage()
+		}()
+		close(start)
+		wg.Wait()
+		close(errs)
+		for err := range errs {
+			if err != nil {
+				t.Fatalf("iteration %d persistence error: %v", i, err)
+			}
+		}
+		state, err := LoadState(path)
+		if err != nil {
+			t.Fatalf("iteration %d state load: %v", i, err)
+		}
+		found := false
+		for _, alias := range state.Aliases {
+			if alias.Alias == aliasName {
+				found = true
+				break
+			}
+		}
+		if !found {
+			t.Fatalf("iteration %d alias %q was lost from persisted state", i, aliasName)
+		}
+	}
+}
 
