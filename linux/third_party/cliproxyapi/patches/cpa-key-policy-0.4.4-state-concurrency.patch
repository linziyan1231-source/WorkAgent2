+
+// persistState serializes full-state writes with usage-only flushes and takes
+// its snapshot only after obtaining that serialization lock. This prevents a
+// periodic flush from restoring stale keys or aliases after a management
+// mutation has already been persisted.
+func (s *Store) persistState() error {
+	s.persistMu.Lock()
+	defer s.persistMu.Unlock()
+	s.mu.RLock()
+	keys := s.keysSnapshotLocked()
+	usage := s.usageSnapshotLocked()
+	aliases := s.aliasesSnapshotLocked()
+	rules := s.classifyRulesSnapshotLocked()
+	path := s.statePath
+	s.mu.RUnlock()
+	if path == "" {
+		return nil
+	}
+	return SaveState(path, keys, usage, aliases, rules)
+}
 
