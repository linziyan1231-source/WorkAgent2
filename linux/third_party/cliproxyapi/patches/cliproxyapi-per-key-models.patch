+package openai
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestModelsAllowedForAccessScopesCPAKeyToExactAliases(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(nil)
+	c.Set("accessProvider", "plugin:cpa-key-policy:cpa-key-policy")
+	c.Set("accessMetadata", map[string]string{
+		"key_id":         "employee-chatgpt",
+		"allowed_models": `["gpt-5.6-luna","gpt-5.6-sol","gpt-5.6-terra"]`,
+	})
+	models := []map[string]any{
+		{"id": "gpt-5.4", "object": "model"},
+		{"id": "gpt-5.6-terra", "object": "model"},
+		{"id": "kimi-for-coding", "object": "model"},
+		{"id": "gpt-5.6-luna", "object": "model"},
+		{"id": "gpt-5.6-sol", "object": "model"},
+	}
+
+	filtered, err := modelsAllowedForAccess(c, models)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := make([]string, 0, len(filtered))
+	for _, model := range filtered {
+		got = append(got, model["id"].(string))
+	}
+	want := []string{"gpt-5.6-luna", "gpt-5.6-sol", "gpt-5.6-terra"}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("model ids = %v, want %v", got, want)
+	}
+}
+
+func TestModelsAllowedForAccessSynthesizesClientAlias(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(nil)
+	c.Set("accessProvider", "plugin:cpa-key-policy:cpa-key-policy")
+	c.Set("accessMetadata", map[string]string{"allowed_models": `["kimi-for-coding"]`})
+
+	filtered, err := modelsAllowedForAccess(c, []map[string]any{{"id": "kimi-k2.7-code", "object": "model"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []map[string]any{{"id": "kimi-for-coding", "object": "model", "owned_by": "cpa-key-policy"}}
+	if !reflect.DeepEqual(filtered, want) {
+		t.Fatalf("models = %#v, want %#v", filtered, want)
+	}
+}
+
+func TestModelsAllowedForAccessFailsClosedOnInvalidCPAMetadata(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, metadata := range []map[string]string{
+		{},
+		{"allowed_models": `not-json`},
+		{"allowed_models": `["gpt-5.6-luna",""]`},
+	} {
+		c, _ := gin.CreateTestContext(nil)
+		c.Set("accessProvider", "plugin:cpa-key-policy:cpa-key-policy")
+		c.Set("accessMetadata", metadata)
+		if models, err := modelsAllowedForAccess(c, []map[string]any{{"id": "gpt-5.4"}}); err == nil || models != nil {
+			t.Fatalf("metadata = %#v: models = %#v, err = %v", metadata, models, err)
+		}
+	}
+}
+
+func TestModelsAllowedForAccessLeavesOtherProvidersUnchanged(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	c, _ := gin.CreateTestContext(nil)
+	c.Set("accessProvider", "config-inline")
+	models := []map[string]any{{"id": "gpt-5.4"}}
+	filtered, err := modelsAllowedForAccess(c, models)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(filtered, models) {
+		t.Fatalf("models = %#v", filtered)
+	}
+}
