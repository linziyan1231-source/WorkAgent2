+func modelsAllowedForAccess(c *gin.Context, models []map[string]any) ([]map[string]any, error) {
+	provider, ok := c.Get("accessProvider")
+	if !ok || provider != "plugin:cpa-key-policy:cpa-key-policy" {
+		return models, nil
+	}
+	metadataValue, ok := c.Get("accessMetadata")
+	if !ok {
+		return nil, fmt.Errorf("cpa-key-policy authentication metadata is missing")
+	}
+	metadata, ok := metadataValue.(map[string]string)
+	if !ok {
+		return nil, fmt.Errorf("cpa-key-policy authentication metadata has type %T", metadataValue)
+	}
+	encoded, ok := metadata["allowed_models"]
+	if !ok {
+		return nil, fmt.Errorf("cpa-key-policy allowed_models metadata is missing")
+	}
+	var allowedIDs []string
+	if err := json.Unmarshal([]byte(encoded), &allowedIDs); err != nil {
+		return nil, fmt.Errorf("decode cpa-key-policy allowed_models: %w", err)
+	}
+	available := make(map[string]map[string]any, len(models))
+	for _, model := range models {
+		id, _ := model["id"].(string)
+		id = strings.ToLower(strings.TrimSpace(id))
+		if id != "" {
+			available[id] = model
+		}
+	}
+	filtered := make([]map[string]any, 0, len(allowedIDs))
+	seen := make(map[string]struct{}, len(allowedIDs))
+	for _, allowedID := range allowedIDs {
+		allowedID = strings.TrimSpace(allowedID)
+		key := strings.ToLower(allowedID)
+		if key == "" {
+			return nil, fmt.Errorf("cpa-key-policy allowed_models contains an empty id")
+		}
+		if _, ok := seen[key]; ok {
+			continue
+		}
+		seen[key] = struct{}{}
+		if model, ok := available[key]; ok {
+			filtered = append(filtered, model)
+		} else {
+			filtered = append(filtered, map[string]any{
+				"id":       allowedID,
+				"object":   "model",
+				"owned_by": "cpa-key-policy",
+			})
+		}
+	}
+	return filtered, nil
+}
