+import { spawnSync } from 'node:child_process';
+import { describe, expect, it } from 'vitest';
+
+const TEST_BUN = process.env.WORKAGENT_TEST_BUN ?? (process.versions.bun ? process.execPath : undefined);
+const TOKEN = 'A'.repeat(43);
+const TENANT = '11111111-1111-4111-8111-111111111111';
+
+describe('WorkAgent runtime socket process boundary', () => {
+  it.skipIf(!TEST_BUN)('delivers one real packet and leaves an accidental standalone fd 3 untouched', () => {
+    const socketModule = new URL('./runtime-socket-bootstrap.ts', import.meta.url).href;
+    const authModule = new URL('./workagent-runtime-auth.ts', import.meta.url).href;
+    const managedChildScript = `
+      import fs from 'node:fs';
+      import { consumeWorkAgentRuntimeAuth } from ${JSON.stringify(authModule)};
+      const initialEnvironment = fs.readFileSync('/proc/self/environ');
+      const initialArguments = fs.readFileSync('/proc/self/cmdline');
+      const auth = await consumeWorkAgentRuntimeAuth(process.env);
+      let fdClosed = false;
+      try { fs.fstatSync(3); } catch (error) { fdClosed = error?.code === 'EBADF'; }
+      const rawToken = Buffer.from(auth?.token ?? '', 'ascii');
+      console.log(JSON.stringify({
+        tenant: auth?.tenantId,
+        tokenLength: auth?.token.length,
+        tokenEnumerable: Object.keys(auth ?? {}).includes('token'),
+        tokenInEnvironment: initialEnvironment.includes(rawToken),
+        tokenInArguments: initialArguments.includes(rawToken),
+        fdClosed,
+      }));
+    `;
+    const standaloneChildScript = `
+      import fs from 'node:fs';
+      import { consumeWorkAgentRuntimeAuth } from ${JSON.stringify(authModule)};
+      const before = fs.fstatSync(3).isSocket();
+      const auth = await consumeWorkAgentRuntimeAuth(process.env);
+      const after = fs.fstatSync(3).isSocket();
+      console.log(JSON.stringify({ before, after, standalone: auth === undefined }));
+    `;
+    const parentScript = `
+      import { spawn } from 'node:child_process';
+      import { createRuntimeSocketBootstrap } from ${JSON.stringify(socketModule)};
+      const token = 'A'.repeat(43);
+      const tenant = ${JSON.stringify(TENANT)};
+      const run = (script, environment, descriptor) => {
+        const child = spawn(process.execPath, ['-e', script], {
+          env: environment,
+          stdio: ['ignore', 'pipe', 'pipe', descriptor],
+        });
+        let stdout = '';
+        let stderr = '';
+        child.stdout.on('data', (chunk) => { stdout += chunk; });
+        child.stderr.on('data', (chunk) => { stderr += chunk; });
+        return { child, completed: new Promise((resolve) => child.on('close', (code, signal) => resolve({ code, signal, stdout, stderr }))) };
+      };
+
+      const managedSocket = await createRuntimeSocketBootstrap();
+      const managed = run(${JSON.stringify(managedChildScript)}, {
+        PATH: process.env.PATH,
+        WORKAGENT_TENANT_ID: tenant,
+        WORKAGENT_RUNTIME_FD: '3',
+      }, managedSocket.childFd);
+      managedSocket.deliver(token);
+      const managedResult = await managed.completed;
+
+      const standaloneSocket = await createRuntimeSocketBootstrap();
+      const standalone = run(${JSON.stringify(standaloneChildScript)}, { PATH: process.env.PATH }, standaloneSocket.childFd);
+      standaloneSocket.close();
+      const standaloneResult = await standalone.completed;
+      console.log(JSON.stringify({ managedResult, standaloneResult }));
+    `;
+
+    const result = spawnSync(TEST_BUN!, ['-e', parentScript], {
+      encoding: 'utf8',
+      timeout: 20_000,
+      env: { PATH: process.env.PATH },
+    });
+    expect(result.status, result.stderr).toBe(0);
+    const output = JSON.parse(result.stdout.trim()) as {
+      managedResult: { code: number; signal: string | null; stdout: string; stderr: string };
+      standaloneResult: { code: number; signal: string | null; stdout: string; stderr: string };
+    };
+    expect(output.managedResult, output.managedResult.stderr).toMatchObject({ code: 0, signal: null });
+    expect(JSON.parse(output.managedResult.stdout.trim())).toEqual({
+      tenant: TENANT,
+      tokenLength: TOKEN.length,
+      tokenEnumerable: false,
+      tokenInEnvironment: false,
+      tokenInArguments: false,
+      fdClosed: true,
+    });
+    expect(output.standaloneResult, output.standaloneResult.stderr).toMatchObject({ code: 0, signal: null });
+    expect(JSON.parse(output.standaloneResult.stdout.trim())).toEqual({
+      before: true,
+      after: true,
+      standalone: true,
+    });
+  });
+});
