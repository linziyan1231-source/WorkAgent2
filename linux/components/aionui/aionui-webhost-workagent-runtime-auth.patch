+import fs from 'node:fs';
+import { buildWorkAgentRuntimeFrame, WORKAGENT_RUNTIME_FRAME_BYTES } from './workagent-runtime-auth.js';
+
+const AF_UNIX = 1;
+const SOCK_SEQPACKET = 5;
+const SOCK_CLOEXEC = 0x80000;
+const SOL_SOCKET = 1;
+const SO_TYPE = 3;
+const SO_PEERCRED = 17;
+const SO_RCVTIMEO = 20;
+const SO_DOMAIN = 39;
+const SHUT_WR = 1;
+const POLLHUP = 0x10;
+const POLLRDHUP = 0x2000;
+
+type LibC = Readonly<{
+  symbols: {
+    socketpair: (domain: number, type: number, protocol: number, descriptors: number) => number;
+    getsockopt: (fd: number, level: number, option: number, value: number, length: number) => number;
+    setsockopt: (fd: number, level: number, option: number, value: number, length: number) => number;
+    shutdown: (fd: number, how: number) => number;
+    poll: (fds: number, count: number, timeoutMs: number) => number;
+  };
+  close: () => void;
+}>;
+
+type BunFFI = Readonly<{
+  FFIType: Record<string, number>;
+  ptr: (view: ArrayBufferView) => number;
+  dlopen: (path: string, symbols: Record<string, unknown>) => LibC;
+}>;
+
+async function openLibC(): Promise<{ ffi: BunFFI; libc: LibC }> {
+  if (process.platform !== 'linux') throw new Error('runtime credential sockets require Linux');
+  // `bun:ffi` is a Bun runtime builtin and is deliberately loaded only on the
+  // WorkAgent Linux path so upstream Node/Vitest and standalone modes remain unchanged.
+  // @ts-expect-error Bun-only builtin is resolved by the verified compile/runtime toolchain.
+  const ffi = (await import('bun:ffi')) as BunFFI;
+  const int = ffi.FFIType.i32;
+  const pointer = ffi.FFIType.ptr;
+  const libc = ffi.dlopen('libc.so.6', {
+    socketpair: { args: [int, int, int, pointer], returns: int },
+    getsockopt: { args: [int, int, int, pointer, pointer], returns: int },
+    setsockopt: { args: [int, int, int, pointer, int], returns: int },
+    shutdown: { args: [int, int], returns: int },
+    poll: { args: [pointer, ffi.FFIType.usize, int], returns: int },
+  });
+  return { ffi, libc };
+}
+
+/** Distinguish a true peer shutdown from a zero-length SOCK_SEQPACKET record. */
+export async function runtimeSocketPeerClosed(fd: number): Promise<boolean> {
+  const { ffi, libc } = await openLibC();
+  const pollFD = Buffer.alloc(8);
+  pollFD.writeInt32LE(fd, 0);
+  pollFD.writeInt16LE(POLLRDHUP, 4);
+  try {
+    const result = libc.symbols.poll(ffi.ptr(pollFD), 1, 0);
+    if (result < 0) throw new Error('runtime credential poll failed');
+    const events = pollFD.readInt16LE(6);
+    return result === 1 && (events & (POLLHUP | POLLRDHUP)) !== 0;
+  } finally {
+    pollFD.fill(0);
+    libc.close();
+  }
+}
+
+function closeDescriptor(fd: number): void {
+  if (fd < 0) return;
+  try {
+    fs.closeSync(fd);
+  } catch {
+    // Cleanup is best effort; callers already fail the startup boundary.
+  }
+}
+
+async function socketOption(fd: number, option: number, slots: number): Promise<Int32Array> {
+  const { ffi, libc } = await openLibC();
+  const value = new Int32Array(slots);
+  const length = new Uint32Array([value.byteLength]);
+  try {
+    if (libc.symbols.getsockopt(fd, SOL_SOCKET, option, ffi.ptr(value), ffi.ptr(length)) !== 0) {
+      throw new Error('getsockopt failed');
+    }
+    if (length[0] !== value.byteLength) throw new Error('getsockopt length mismatch');
+    return value;
+  } finally {
+    libc.close();
+  }
+}
+
+/** Validate inherited fd identity/peer and bound all subsequent blocking reads. */
+export async function validateInheritedRuntimeSocket(
+  fd: number,
+  expectedPeerPid: number,
+  expectedPeerUid: number | undefined
+): Promise<void> {
+  if (!Number.isSafeInteger(fd) || fd < 0 || expectedPeerUid === undefined || !fs.fstatSync(fd).isSocket()) {
+    throw new Error('invalid runtime credential descriptor');
+  }
+  const domain = await socketOption(fd, SO_DOMAIN, 1);
+  const type = await socketOption(fd, SO_TYPE, 1);
+  const peer = await socketOption(fd, SO_PEERCRED, 3);
+  if (
+    domain[0] !== AF_UNIX ||
+    type[0] !== SOCK_SEQPACKET ||
+    peer[0] !== expectedPeerPid ||
+    peer[1] !== expectedPeerUid
+  ) {
+    throw new Error('runtime credential peer mismatch');
+  }
+
+  const { ffi, libc } = await openLibC();
+  // Linux x86_64 `timeval` is two little-endian 64-bit signed fields. Writing
+  // the low 32 bits keeps this source compatible with the upstream ES6 target.
+  const timeout = Buffer.alloc(16);
+  timeout.writeInt32LE(10, 0);
+  try {
+    if (libc.symbols.setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, ffi.ptr(timeout), timeout.byteLength) !== 0) {
+      throw new Error('runtime credential timeout setup failed');
+    }
+  } finally {
+    timeout.fill(0);
+    libc.close();
+  }
+}
+
+export type RuntimeSocketBootstrap = Readonly<{
+  childFd: number;
+  deliver: (token: string) => void;
+  close: () => void;
+}>;
+
+/** Create a fresh anonymous channel for one exact AionCore Start attempt. */
+export async function createRuntimeSocketBootstrap(): Promise<RuntimeSocketBootstrap> {
+  const { ffi, libc } = await openLibC();
+  const descriptors = new Int32Array([-1, -1]);
+  try {
+    if (libc.symbols.socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, ffi.ptr(descriptors)) !== 0) {
+      throw new Error('socketpair failed');
+    }
+  } catch (error) {
+    libc.close();
+    throw error;
+  }
+  let parentFd = descriptors[0];
+  let childFd = descriptors[1];
+  descriptors.fill(-1);
+  if (parentFd < 0 || childFd < 0) {
+    closeDescriptor(parentFd);
+    closeDescriptor(childFd);
+    libc.close();
+    throw new Error('socketpair returned invalid descriptors');
+  }
+
+  let libcOpen = true;
+  const closeLibC = (): void => {
+    if (!libcOpen) return;
+    libcOpen = false;
+    libc.close();
+  };
+
+  const close = (): void => {
+    closeDescriptor(childFd);
+    closeDescriptor(parentFd);
+    childFd = -1;
+    parentFd = -1;
+    closeLibC();
+  };
+  return {
+    get childFd() {
+      return childFd;
+    },
+    deliver(token: string): void {
+      if (childFd < 0 || parentFd < 0) throw new Error('runtime credential channel was already consumed');
+      const frame = buildWorkAgentRuntimeFrame(token);
+      try {
+        fs.closeSync(childFd);
+        childFd = -1;
+        const written = fs.writeSync(parentFd, frame, 0, frame.byteLength, null);
+        if (written !== WORKAGENT_RUNTIME_FRAME_BYTES) throw new Error('runtime credential frame was short');
+        if (libc.symbols.shutdown(parentFd, SHUT_WR) !== 0) throw new Error('runtime credential shutdown failed');
+        fs.closeSync(parentFd);
+        parentFd = -1;
+      } finally {
+        frame.fill(0);
+        close();
+      }
+    },
+    close,
+  };
+}
