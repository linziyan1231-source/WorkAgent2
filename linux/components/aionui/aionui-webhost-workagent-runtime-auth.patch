@@ -0,0 +1,310 @@
+import { spawn, type ChildProcess } from 'node:child_process';
+import fs from 'node:fs';
+import path from 'node:path';
+import {
+  WORKAGENT_RUNTIME_FD_ENV,
+  WORKAGENT_RUNTIME_FRAME_BYTES,
+  WORKAGENT_RUNTIME_HEADER,
+  WORKAGENT_TENANT_ENV,
+  consumeWorkAgentRuntimeAuth,
+} from '../src/workagent-runtime-auth.js';
+import { createRuntimeSocketBootstrap } from '../src/runtime-socket-bootstrap.js';
+
+const TOKEN = 'A'.repeat(43);
+const TENANT = '11111111-1111-4111-8111-111111111111';
+const MAX_OUTPUT_BYTES = 2 * 1024 * 1024;
+
+function argumentAfter(name: string): string {
+  const index = process.argv.indexOf(name);
+  const value = index >= 0 ? process.argv[index + 1] : undefined;
+  if (!value) throw new Error(`missing ${name}`);
+  return value;
+}
+
+function cleanEnvironment(): NodeJS.ProcessEnv {
+  const environment = { ...process.env };
+  delete environment[WORKAGENT_TENANT_ENV];
+  delete environment[WORKAGENT_RUNTIME_FD_ENV];
+  delete environment.WORKAGENT_RUNTIME_TOKEN;
+  return environment;
+}
+
+async function runFakeAionCore(): Promise<void> {
+  const auth = await consumeWorkAgentRuntimeAuth(process.env);
+  if (!auth) throw new Error('fake AionCore requires WorkAgent runtime auth');
+  const server = Bun.serve({
+    hostname: '127.0.0.1',
+    port: 0,
+    fetch(request) {
+      if (request.headers.get(WORKAGENT_RUNTIME_HEADER) !== auth.token) {
+        return new Response('forbidden', { status: 403 });
+      }
+      if (new URL(request.url).pathname === '/health') return new Response('ok');
+      return new Response('not found', { status: 404 });
+    },
+  });
+  console.log(`AIONCORE_LISTENING ${JSON.stringify({ host: '127.0.0.1', port: server.port })}`);
+  console.log(`WORKAGENT_SMOKE_CORE_PID ${process.pid}`);
+  const stop = (): void => {
+    server.stop(true);
+    process.exit(0);
+  };
+  process.once('SIGINT', stop);
+  process.once('SIGTERM', stop);
+}
+
+type CapturedChild = Readonly<{
+  child: ChildProcess;
+  output: () => string;
+  completed: Promise<{ code: number | null; signal: NodeJS.Signals | null }>;
+}>;
+
+function spawnCaptured(command: string, arguments_: string[], options: Parameters<typeof spawn>[2]): CapturedChild {
+  const child = spawn(command, arguments_, options);
+  let output = '';
+  let outputFailure: Error | undefined;
+  const append = (chunk: Buffer): void => {
+    if (outputFailure) return;
+    if (Buffer.byteLength(output) + chunk.byteLength > MAX_OUTPUT_BYTES) {
+      outputFailure = new Error('artifact smoke output exceeded its bound');
+      child.kill('SIGKILL');
+      return;
+    }
+    output += chunk.toString();
+  };
+  child.stdout?.on('data', append);
+  child.stderr?.on('data', append);
+  const completed = new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve, reject) => {
+    child.once('error', reject);
+    child.once('close', (code, signal) => {
+      if (outputFailure) reject(outputFailure);
+      else resolve({ code, signal });
+    });
+  });
+  return { child, output: () => output, completed };
+}
+
+async function waitForManagedReady(process_: CapturedChild): Promise<{ frontendURL: string; corePID: number }> {
+  const deadline = Date.now() + 30_000;
+  while (Date.now() < deadline) {
+    const output = process_.output();
+    const frontend = /^  Local  : (http:\/\/127\.0\.0\.1:[1-9][0-9]*\/?)/m.exec(output);
+    const core = /\[aioncore\] WORKAGENT_SMOKE_CORE_PID ([1-9][0-9]*)/.exec(output);
+    if (frontend && core && output.includes('AionUi WebUI is ready')) {
+      return { frontendURL: frontend[1], corePID: Number(core[1]) };
+    }
+    if (process_.child.exitCode !== null || process_.child.signalCode !== null) {
+      throw new Error(`managed artifact exited before readiness\n${output}`);
+    }
+    await Bun.sleep(50);
+  }
+  throw new Error(`managed artifact readiness timed out\n${process_.output()}`);
+}
+
+function verifySecretAbsent(pid: number): void {
+  for (const name of ['cmdline', 'environ']) {
+    const content = fs.readFileSync(path.join('/proc', String(pid), name));
+    try {
+      if (content.includes(Buffer.from(TOKEN)) || content.includes(Buffer.from('WORKAGENT_RUNTIME_TOKEN='))) {
+        throw new Error(`runtime token appeared in ${pid}/${name}`);
+      }
+    } finally {
+      content.fill(0);
+    }
+  }
+}
+
+function processStartTime(pid: number): string | undefined {
+  let content: string;
+  try {
+    content = fs.readFileSync(path.join('/proc', String(pid), 'stat'), 'utf8');
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined;
+    throw error;
+  }
+  const closing = content.lastIndexOf(')');
+  const fields =
+    closing >= 0
+      ? content
+          .slice(closing + 2)
+          .trim()
+          .split(/\s+/)
+      : [];
+  if (fields.length < 20 || !/^\d+$/.test(fields[19])) throw new Error('artifact smoke process identity is invalid');
+  return fields[19];
+}
+
+async function duplicateDescriptor(fd: number): Promise<number> {
+  // @ts-expect-error Bun-only builtin used by the pinned Linux smoke toolchain.
+  const { dlopen, FFIType } = await import('bun:ffi');
+  const libc = dlopen('libc.so.6', {
+    fcntl: { args: [FFIType.i32, FFIType.i32, FFIType.i32], returns: FFIType.i32 },
+  });
+  try {
+    const duplicate = libc.symbols.fcntl(fd, 1030, 4); // F_DUPFD_CLOEXEC
+    if (duplicate < 0) throw new Error('duplicate standalone fd 3 observer');
+    return duplicate;
+  } finally {
+    libc.close();
+  }
+}
+
+async function stopManaged(process_: CapturedChild): Promise<void> {
+  if (!process_.child.pid || process_.child.exitCode !== null || process_.child.signalCode !== null) return;
+  try {
+    process.kill(-process_.child.pid, 'SIGTERM');
+  } catch {
+    process_.child.kill('SIGTERM');
+  }
+  const stopped = await Promise.race([process_.completed.then(() => true), Bun.sleep(10_000).then(() => false)]);
+  if (stopped) return;
+  try {
+    process.kill(-process_.child.pid, 'SIGKILL');
+  } catch {
+    process_.child.kill('SIGKILL');
+  }
+  await process_.completed;
+}
+
+async function enforceBackendStopped(pid: number, expectedStartTime: string): Promise<void> {
+  for (let attempt = 0; attempt < 100; attempt++) {
+    const current = processStartTime(pid);
+    if (current === undefined || current !== expectedStartTime) return;
+    await Bun.sleep(50);
+  }
+  let cleanupSignal: NodeJS.Signals = 'SIGTERM';
+  try {
+    process.kill(-pid, cleanupSignal);
+  } catch {
+    process.kill(pid, cleanupSignal);
+  }
+  for (let attempt = 0; attempt < 20; attempt++) {
+    const current = processStartTime(pid);
+    if (current === undefined || current !== expectedStartTime) {
+      throw new Error('managed artifact left its backend process alive after shutdown');
+    }
+    await Bun.sleep(50);
+  }
+  cleanupSignal = 'SIGKILL';
+  try {
+    process.kill(-pid, cleanupSignal);
+  } catch {
+    process.kill(pid, cleanupSignal);
+  }
+  throw new Error('managed artifact left its backend process alive after shutdown');
+}
+
+async function runArtifactSmoke(): Promise<void> {
+  const artifact = path.resolve(argumentAfter('--artifact'));
+  const staticRoot = path.resolve(argumentAfter('--static-root'));
+  const scratch = path.resolve(argumentAfter('--scratch'));
+  for (const target of [artifact, path.join(staticRoot, 'index.html')]) {
+    if (!fs.statSync(target).isFile()) throw new Error(`smoke input is not a file: ${target}`);
+  }
+  fs.mkdirSync(scratch, { recursive: true, mode: 0o700 });
+
+  const standaloneSocket = await createRuntimeSocketBootstrap();
+  const observerFD = await duplicateDescriptor(standaloneSocket.childFd);
+  const standalone = spawnCaptured(artifact, ['version'], {
+    env: cleanEnvironment(),
+    stdio: ['ignore', 'pipe', 'pipe', standaloneSocket.childFd],
+  });
+  standaloneSocket.deliver(TOKEN);
+  const standaloneExit = await standalone.completed;
+  const unreadPacket = Buffer.alloc(64);
+  let unreadLength = -1;
+  try {
+    unreadLength = fs.readSync(observerFD, unreadPacket, 0, unreadPacket.byteLength, null);
+  } finally {
+    fs.closeSync(observerFD);
+    unreadPacket.fill(0);
+  }
+  if (standaloneExit.code !== 0 || standalone.output().trim() !== '2.1.0-beta.editfork.29') {
+    throw new Error(`standalone fd3 version smoke failed\n${standalone.output()}`);
+  }
+  if (unreadLength !== WORKAGENT_RUNTIME_FRAME_BYTES) {
+    throw new Error(`standalone mode consumed malicious readable fd3: remaining=${unreadLength}`);
+  }
+
+  const dataRoot = path.join(scratch, 'data');
+  const logRoot = path.join(scratch, 'logs');
+  const workRoot = path.join(scratch, 'work');
+  for (const directory of [dataRoot, logRoot, workRoot]) fs.mkdirSync(directory, { recursive: true, mode: 0o700 });
+  const managedSocket = await createRuntimeSocketBootstrap();
+  const environment = cleanEnvironment();
+  environment[WORKAGENT_TENANT_ENV] = TENANT;
+  environment[WORKAGENT_RUNTIME_FD_ENV] = '3';
+  environment.AIONUI_OPEN_BROWSER = '0';
+  const managed = spawnCaptured(
+    artifact,
+    [
+      'start',
+      '--port',
+      '0',
+      '--no-open',
+      '--data-dir',
+      dataRoot,
+      '--log-dir',
+      logRoot,
+      '--work-dir',
+      workRoot,
+      '--static-dir',
+      staticRoot,
+      '--backend-bin',
+      process.execPath,
+    ],
+    {
+      cwd: workRoot,
+      detached: true,
+      env: environment,
+      stdio: ['ignore', 'pipe', 'pipe', managedSocket.childFd],
+    }
+  );
+  if (!managed.child.pid) throw new Error('managed artifact did not return a PID');
+  let corePID = 0;
+  let coreStartTime = '';
+  try {
+    managedSocket.deliver(TOKEN);
+    const ready = await waitForManagedReady(managed);
+    corePID = ready.corePID;
+    coreStartTime = processStartTime(corePID) ?? '';
+    if (!coreStartTime) throw new Error('managed artifact backend identity disappeared before verification');
+    // The readiness line is emitted immediately before the CLI installs its
+    // signal handlers. Cross that tiny boundary before exercising shutdown.
+    await Bun.sleep(250);
+    if (managed.output().includes(TOKEN)) throw new Error('runtime token appeared in managed artifact output');
+    verifySecretAbsent(managed.child.pid);
+    verifySecretAbsent(ready.corePID);
+
+    const missing = await fetch(ready.frontendURL, { redirect: 'manual' });
+    const wrong = await fetch(ready.frontendURL, {
+      redirect: 'manual',
+      headers: { [WORKAGENT_RUNTIME_HEADER]: 'B'.repeat(43) },
+    });
+    const authenticated = await fetch(ready.frontendURL, {
+      redirect: 'manual',
+      headers: { [WORKAGENT_RUNTIME_HEADER]: TOKEN },
+    });
+    await Promise.all([missing.body?.cancel(), wrong.body?.cancel(), authenticated.body?.cancel()]);
+    if (missing.status !== 403 || wrong.status !== 403 || authenticated.status !== 200) {
+      throw new Error(
+        `managed frontend auth statuses missing=${missing.status} wrong=${wrong.status} authenticated=${authenticated.status}`
+      );
+    }
+  } finally {
+    let stopError: unknown;
+    try {
+      await stopManaged(managed);
+    } catch (error) {
+      stopError = error;
+    }
+    if (corePID && coreStartTime) await enforceBackendStopped(corePID, coreStartTime);
+    if (stopError) throw stopError;
+  }
+}
+
+const action = process.argv.includes('--orchestrate') ? runArtifactSmoke() : runFakeAionCore();
+action.catch((error) => {
+  console.error(error instanceof Error ? error.message : 'unknown runtime artifact smoke failure');
+  process.exit(1);
+});
