+import { timingSafeEqual } from 'node:crypto';
+import fs from 'node:fs';
+
+export const WORKAGENT_TENANT_ENV = 'WORKAGENT_TENANT_ID';
+export const WORKAGENT_RUNTIME_FD_ENV = 'WORKAGENT_RUNTIME_FD';
+export const WORKAGENT_RUNTIME_FD = 3;
+export const WORKAGENT_RUNTIME_HEADER = 'X-WorkAgent-Runtime-Token';
+export const WORKAGENT_BOOTSTRAP_CONFIG_ERROR = 'BOOTSTRAP_CONFIG_INVALID stage=config.workagent_runtime';
+export const WORKAGENT_RUNTIME_FRAME_MAGIC = 'WATOKN1\0';
+export const WORKAGENT_RUNTIME_FRAME_BYTES = 42;
+export const WORKAGENT_RUNTIME_TOKEN_BYTES = 32;
+const REMOVED_WORKAGENT_RUNTIME_TOKEN_ENV = 'WORKAGENT_RUNTIME_TOKEN';
+
+export type WorkAgentRuntimeAuth = Readonly<{
+  tenantId: string;
+  token: string;
+}>;
+
+export type WorkAgentRuntimeSocketIO = Readonly<{
+  validate: (fd: number) => Promise<void> | void;
+  read: (fd: number, buffer: Buffer) => number;
+  peerClosed: (fd: number) => Promise<boolean> | boolean;
+  close: (fd: number) => void;
+}>;
+
+export class WorkAgentRuntimeConfigError extends Error {
+  constructor() {
+    super(WORKAGENT_BOOTSTRAP_CONFIG_ERROR);
+    this.name = 'WorkAgentRuntimeConfigError';
+  }
+}
+
+function hasOwn(environment: NodeJS.ProcessEnv, name: string): boolean {
+  return Object.prototype.hasOwnProperty.call(environment, name) && environment[name] !== undefined;
+}
+
+function redactedRuntimeAuth(tenantId: string, token: string): WorkAgentRuntimeAuth {
+  const value = Object.create(null) as WorkAgentRuntimeAuth;
+  Object.defineProperties(value, {
+    tenantId: { value: tenantId, enumerable: true, writable: false, configurable: false },
+    token: { value: token, enumerable: false, writable: false, configurable: false },
+    toJSON: {
+      value: () => ({ tenantId, token: '[REDACTED]' }),
+      enumerable: false,
+      writable: false,
+      configurable: false,
+    },
+  });
+  return Object.freeze(value);
+}
+
+export function isCanonicalWorkAgentRuntimeToken(value: unknown): value is string {
+  if (typeof value !== 'string') return false;
+  if (!/^[A-Za-z0-9_-]{43}$/.test(value)) return false;
+  const decoded = Buffer.from(value, 'base64url');
+  return decoded.byteLength === 32 && decoded.toString('base64url') === value;
+}
+
+function workAgentTenantIdIsValid(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.trim().length > 0 &&
+    value.trim() === value &&
+    !/[\u0000-\u001f\u007f-\u009f]/.test(value)
+  );
+}
+
+export function workAgentRuntimeAuthIsValid(value: WorkAgentRuntimeAuth): boolean {
+  return (
+    workAgentTenantIdIsValid(value?.tenantId) &&
+    typeof value?.token === 'string' &&
+    isCanonicalWorkAgentRuntimeToken(value.token)
+  );
+}
+
+export function resolveWorkAgentRuntimeTenant(
+  environment: NodeJS.ProcessEnv,
+  localRequested = false
+): string | undefined {
+  const tenantPresent = hasOwn(environment, WORKAGENT_TENANT_ENV);
+  const fdPresent = hasOwn(environment, WORKAGENT_RUNTIME_FD_ENV);
+  const removedTokenPresent = hasOwn(environment, REMOVED_WORKAGENT_RUNTIME_TOKEN_ENV);
+  if (!tenantPresent && !fdPresent && !removedTokenPresent) return undefined;
+
+  const tenantId = environment[WORKAGENT_TENANT_ENV] ?? '';
+  if (
+    removedTokenPresent ||
+    !tenantPresent ||
+    !fdPresent ||
+    environment[WORKAGENT_RUNTIME_FD_ENV] !== String(WORKAGENT_RUNTIME_FD) ||
+    localRequested ||
+    !workAgentTenantIdIsValid(tenantId)
+  ) {
+    throw new WorkAgentRuntimeConfigError();
+  }
+  return tenantId;
+}
+
+function defaultRuntimeSocketIO(): WorkAgentRuntimeSocketIO {
+  return {
+    validate: async (fd) => {
+      const { validateInheritedRuntimeSocket } = await import('./runtime-socket-bootstrap.js');
+      await validateInheritedRuntimeSocket(fd, process.ppid, process.getuid?.());
+    },
+    read: (fd, buffer) => fs.readSync(fd, buffer, 0, buffer.byteLength, null),
+    peerClosed: async (fd) => {
+      const { runtimeSocketPeerClosed } = await import('./runtime-socket-bootstrap.js');
+      return await runtimeSocketPeerClosed(fd);
+    },
+    close: (fd) => fs.closeSync(fd),
+  };
+}
+
+export function buildWorkAgentRuntimeFrame(token: string): Buffer {
+  if (!isCanonicalWorkAgentRuntimeToken(token)) throw new WorkAgentRuntimeConfigError();
+  const raw = Buffer.from(token, 'base64url');
+  const frame = Buffer.alloc(WORKAGENT_RUNTIME_FRAME_BYTES);
+  try {
+    frame.write(WORKAGENT_RUNTIME_FRAME_MAGIC, 0, 'latin1');
+    frame.writeUInt16BE(WORKAGENT_RUNTIME_TOKEN_BYTES, 8);
+    raw.copy(frame, 10);
+    return frame;
+  } finally {
+    raw.fill(0);
+  }
+}
+
+/** Consume one exact credential packet from inherited fd 3 before loading the CLI. */
+export async function consumeWorkAgentRuntimeAuth(
+  environment: NodeJS.ProcessEnv,
+  localRequested = false,
+  socketIO?: WorkAgentRuntimeSocketIO
+): Promise<WorkAgentRuntimeAuth | undefined> {
+  let tenantId: string | undefined;
+  try {
+    tenantId = resolveWorkAgentRuntimeTenant(environment, localRequested);
+  } finally {
+    delete environment[WORKAGENT_TENANT_ENV];
+    delete environment[WORKAGENT_RUNTIME_FD_ENV];
+    delete environment[REMOVED_WORKAGENT_RUNTIME_TOKEN_ENV];
+  }
+  if (!tenantId) return undefined;
+
+  const packet = Buffer.alloc(64);
+  const secondPacket = Buffer.alloc(1);
+  const io = socketIO ?? defaultRuntimeSocketIO();
+  let closed = false;
+  try {
+    await io.validate(WORKAGENT_RUNTIME_FD);
+    const length = io.read(WORKAGENT_RUNTIME_FD, packet);
+    if (
+      length !== WORKAGENT_RUNTIME_FRAME_BYTES ||
+      packet.subarray(0, 8).toString('latin1') !== WORKAGENT_RUNTIME_FRAME_MAGIC ||
+      packet.readUInt16BE(8) !== WORKAGENT_RUNTIME_TOKEN_BYTES
+    ) {
+      throw new WorkAgentRuntimeConfigError();
+    }
+    if (io.read(WORKAGENT_RUNTIME_FD, secondPacket) !== 0 || !(await io.peerClosed(WORKAGENT_RUNTIME_FD))) {
+      throw new WorkAgentRuntimeConfigError();
+    }
+    io.close(WORKAGENT_RUNTIME_FD);
+    closed = true;
+    const token = packet.toString('base64url', 10, WORKAGENT_RUNTIME_FRAME_BYTES);
+    if (!isCanonicalWorkAgentRuntimeToken(token)) throw new WorkAgentRuntimeConfigError();
+    return redactedRuntimeAuth(tenantId, token);
+  } catch {
+    throw new WorkAgentRuntimeConfigError();
+  } finally {
+    if (!closed) {
+      try {
+        io.close(WORKAGENT_RUNTIME_FD);
+      } catch {
+        // Startup is already failing closed; never replace the stable boundary.
+      }
+    }
+    packet.fill(0);
+    secondPacket.fill(0);
+  }
+}
+
+export function runtimeHeaderValueIsValid(value: string | string[] | undefined, expectedToken: string): boolean {
+  if (
+    typeof value !== 'string' ||
+    !isCanonicalWorkAgentRuntimeToken(value) ||
+    !isCanonicalWorkAgentRuntimeToken(expectedToken)
+  )
+    return false;
+  const actual = Buffer.from(value, 'ascii');
+  const expected = Buffer.from(expectedToken, 'ascii');
+  return actual.byteLength === expected.byteLength && timingSafeEqual(actual, expected);
+}
+
+export function runtimeHeaderFromRawHeaders(rawHeaders: readonly string[]): string | undefined {
+  let value: string | undefined;
+  for (let index = 0; index + 1 < rawHeaders.length; index += 2) {
+    if (rawHeaders[index].toLowerCase() !== WORKAGENT_RUNTIME_HEADER.toLowerCase()) continue;
+    if (value !== undefined) return undefined;
+    value = rawHeaders[index + 1];
+  }
+  return value;
+}
+
+export function stripWorkAgentHeaders(headers: Record<string, string | string[] | undefined>): void {
+  for (const name of Object.keys(headers)) {
+    if (name.toLowerCase().startsWith('x-workagent-')) delete headers[name];
+  }
+}
diff --git a/srv/workagent/source/.tools/build/aionui-provenance.90MqLu/current/packages/web-host/tests/runtime-artifact-smoke.ts b/packages/web-host/tests/runtime-artifact-smoke.ts
