@@ -0,0 +1,17 @@
+import { WorkAgentRuntimeConfigError, consumeWorkAgentRuntimeAuth } from '@aionui/web-host/workagent-runtime-auth';
+
+async function bootstrap(): Promise<void> {
+  // This is the compiled entry point. Resolve/consume the possession channel
+  // before dynamically loading any of the normal CLI/web-host module graph.
+  const localRequested = process.argv.slice(2).includes('--local');
+  const workAgentRuntimeAuth = await consumeWorkAgentRuntimeAuth(process.env, localRequested);
+  const { runAionUiCLI } = await import('./index.js');
+  await runAionUiCLI(workAgentRuntimeAuth);
+}
+
+bootstrap().catch((error) => {
+  const err = error instanceof Error ? error : new Error('unknown bootstrap failure');
+  if (err instanceof WorkAgentRuntimeConfigError) console.error(err.message);
+  else console.error('[aionui-web] fatal:', err.message);
+  process.exit(1);
+});
