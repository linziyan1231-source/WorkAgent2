+    expect(runtimeHeaderValueIsValid('\u0141'.repeat(43), TOKEN)).toBe(false);
+    expect(runtimeHeaderValueIsValid(`${'A'.repeat(42)}\u0001`, TOKEN)).toBe(false);
+    expect(runtimeHeaderValueIsValid([TOKEN], TOKEN)).toBe(false);
+  });
+
