+
+const TOKEN = 'A'.repeat(43);
+const TENANT = '11111111-1111-4111-8111-111111111111';
+
+function managedEnvironment(): NodeJS.ProcessEnv {
+  return {
+    PATH: '/bin',
+    WORKAGENT_TENANT_ID: TENANT,
+    WORKAGENT_RUNTIME_FD: String(WORKAGENT_RUNTIME_FD),
+  };
+}
+
+function fakeSocketIO(options?: {
+  first?: Buffer;
+  second?: Buffer | Error;
+  peerClosed?: boolean;
+  validateError?: Error;
+  closeError?: Error;
+}): WorkAgentRuntimeSocketIO & {
+  validate: ReturnType<typeof vi.fn>;
+  read: ReturnType<typeof vi.fn>;
+  peerClosed: ReturnType<typeof vi.fn>;
+  close: ReturnType<typeof vi.fn>;
+} {
+  const first = options?.first ?? buildWorkAgentRuntimeFrame(TOKEN);
+  const second = options?.second ?? Buffer.alloc(0);
+  let readIndex = 0;
+  return {
+    validate: vi.fn(() => {
+      if (options?.validateError) throw options.validateError;
+    }),
+    read: vi.fn((_fd: number, destination: Buffer) => {
+      const value = readIndex++ === 0 ? first : second;
+      if (value instanceof Error) throw value;
+      value.copy(destination, 0, 0, Math.min(value.byteLength, destination.byteLength));
+      return Math.min(value.byteLength, destination.byteLength);
+    }),
+    peerClosed: vi.fn(() => options?.peerClosed ?? true),
+    close: vi.fn(() => {
+      if (options?.closeError) throw options.closeError;
+    }),
+  };
+}
+
+async function expectStableBoundary(promise: Promise<unknown>): Promise<void> {
+  await expect(promise).rejects.toEqual(
+    expect.objectContaining({
+      name: 'WorkAgentRuntimeConfigError',
+      message: WORKAGENT_BOOTSTRAP_CONFIG_ERROR,
+    })
+  );
+}
+
