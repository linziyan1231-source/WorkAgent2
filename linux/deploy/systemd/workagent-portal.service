[Unit]
Description=WorkAgent2 Portal
After=network-online.target workagent-tenant-catalog-ready.target
Wants=network-online.target
Requires=workagent-tenant-catalog-ready.target
RequiresMountsFor=/var/lib/workagent/portal
ConditionFileIsExecutable=/opt/workagent/control/bin/workagent-portal
ConditionFileIsExecutable=/usr/libexec/workagent-core-activation-admission-v1
ConditionFileIsExecutable=/usr/libexec/workagent-recovery-activation-admission-v1
ConditionPathExists=/opt/workagent/control/manifest.json
ConditionPathExists=/run/workagent/release-config.lock
ConditionPathExists=/run/workagent/activation.lock
ConditionPathExists=/opt/workagent/control.lock
ConditionPathExists=/opt/workagent/aionui/current.json.lock
ConditionPathIsReadWrite=/var/lib/workagent/portal

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=60s
User=workagent
Group=workagent
OpenFile=/run/workagent/release-config.lock:workagent-config-lock:read-only
OpenFile=/opt/workagent/control.lock:workagent-control-release-lock:read-only
OpenFile=/opt/workagent/aionui/current.json.lock:workagent-runtime-release-lock:read-only
WorkingDirectory=/var/lib/workagent/portal
ExecStartPre=+/usr/libexec/workagent-core-activation-admission-v1
ExecStartPre=+/usr/libexec/workagent-recovery-activation-admission-v1
ExecStartPre=+/usr/bin/flock --shared /run/workagent/release-config.lock /opt/workagent/control/bin/workagent-release verify --root /opt/workagent/control --scope portal --required-executable bin/workagent-release --required-executable bin/workagent-portal
ExecStart=/bin/bash -c '/usr/bin/flock --shared 3 || exit 70; exec "$@"' workagent-runtime-start /opt/workagent/control/bin/workagent-portal --config /etc/workagent/portal.json
# Provider credentials are intentionally absent from the deny-all staging
# baseline. Production adds LoadCredential entries in a root-owned drop-in.
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=workagent-portal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/workagent/portal /run/workagent
ReadOnlyPaths=/srv/workagent/users

MemoryHigh=1536M
MemoryMax=2G
CPUQuota=200%
TasksMax=512

[Install]
WantedBy=multi-user.target
