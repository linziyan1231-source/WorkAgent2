{
	# Tenant runtimes can reach loopback TCP. Keep the administrative API behind
	# a caddy-owned mode-0700 RuntimeDirectory instead.
	admin unix//run/caddy-admin/admin.sock
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

workagent.example.invalid {
	tls {
		issuer acme {
			# TCP 80 belongs to an unrelated workload. Do not attempt HTTP-01;
			# issuance must succeed through public TCP 443 with TLS-ALPN-01.
			disable_http_challenge
		}
	}

	encode zstd gzip
	log {
		output file /var/log/caddy/workagent-access.log {
			mode 0640
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 720h
		}
		# OAuth callbacks and chat routes can carry sensitive values. Retain
		# status/timing evidence while dropping request URI and all headers.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}

	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy 127.0.0.1:42580 {
		header_up X-Forwarded-Proto https
	}
}
